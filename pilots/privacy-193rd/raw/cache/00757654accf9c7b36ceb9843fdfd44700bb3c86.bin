{"Title":"An Act empowering students and schools to thrive","BillNumber":"H495","DocketNumber":"HD3162","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JKH1","Name":"James K. Hawkins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JKH1","ResponseDate":"2023-01-20T10:17:58.09"},"Cosponsors":[{"Id":"JKH1","Name":"James K. Hawkins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JKH1","ResponseDate":"2023-01-20T10:17:58.09"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-01-20T10:19:03.14"},{"Id":"DAL1","Name":"David Henry Argosky LeBoeuf","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DAL1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"RME1","Name":"Rodney M. Elliott","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RME1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-01-26T09:01:47.6"},{"Id":"J_A1","Name":"James Arciero","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_A1","ResponseDate":"2023-07-27T14:57:51.3033333"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-05-24T12:56:10.48"},{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-03-20T21:29:17.8833333"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-01-26T10:48:47.43"},{"Id":"J_B1","Name":"John Barrett, III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_B1","ResponseDate":"2023-09-21T10:36:09.0466667"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-02-08T10:03:33.5133333"},{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-03-08T11:46:01.44"},{"Id":"DFC1","Name":"Daniel Cahill","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFC1","ResponseDate":"2023-06-14T15:59:55.1633333"},{"Id":"PLC1","Name":"Peter Capano","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PLC1","ResponseDate":"2023-02-06T09:20:28.4733333"},{"Id":"T_C1","Name":"Tackey Chan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_C1","ResponseDate":"2023-02-01T15:24:10.33"},{"Id":"M_C2","Name":"Michelle L. Ciccolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C2","ResponseDate":"2023-03-02T15:12:16.11"},{"Id":"M_C1","Name":"Mike Connolly","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C1","ResponseDate":"2023-02-02T14:00:51.9033333"},{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-02-27T10:40:13.7133333"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-02-02T16:59:37.05"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2024-03-12T09:58:34.2866667"},{"Id":"K_D1","Name":"Kate Donaghue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_D1","ResponseDate":"2023-02-27T08:46:14.3933333"},{"Id":"DMD1","Name":"Daniel M. Donahue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DMD1","ResponseDate":"2023-04-13T15:02:50.77"},{"Id":"PJD1","Name":"Paul J. Donato","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJD1","ResponseDate":"2023-07-27T12:41:56.5"},{"Id":"MMD1","Name":"Michelle M. DuBois","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MMD1","ResponseDate":"2023-08-08T13:35:32.78"},{"Id":"TFB1","Name":"Tricia Farley-Bouvier","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2023-02-08T14:20:50.2966667"},{"Id":"CRF1","Name":"Christopher Richard Flanagan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CRF1","ResponseDate":"2023-02-23T11:20:35.6066667"},{"Id":"WCG1","Name":"William C. Galvin","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WCG1","ResponseDate":"2023-02-06T09:56:48.12"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-07-31T13:16:46.96"},{"Id":"DCG1","Name":"Denise C. Garlick","Type":1,"Det