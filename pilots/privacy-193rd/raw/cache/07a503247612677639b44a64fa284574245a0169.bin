{"Title":"An Act establishing a sick leave bank for Jeanne Rainone","BillNumber":"H5128","DocketNumber":"HD5467","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"D_R1","Name":"David Allen Robertson","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/D_R1","ResponseDate":"2024-10-31T12:33:22.743"},"Cosponsors":[{"Id":"D_R1","Name":"David Allen Robertson","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/D_R1","ResponseDate":"2024-10-31T12:33:22.7433333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5128/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Robertson of Tewksbury, a petition (subject to Joint Rule 12) of David Allen Robertson for legislation to establish a sick leave bank for Jeanne Rainone, an employee of the Department of Children and Families.  Public Service.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the Department of Children and Families shall establish a sick leave bank for Jeanne Rainone, an employee of the department. Any employee of the department may voluntarily contribute 1 or more sick, personal or vacation days to the sick leave bank for use by Jeanne Rainone. If Jeanne Rainone terminates employment with the department or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the department.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}