{"Title":"An Act relative to school safety issues","BillNumber":"S353","DocketNumber":"SD104","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"BET0","Name":"Bruce E. Tarr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0","ResponseDate":"2023-01-10T15:34:41.327"},"Cosponsors":[{"Id":"BET0","Name":"Bruce E. Tarr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0","ResponseDate":"2023-01-10T15:34:41.3266667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S353/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Tarr, a petition (accompanied by bill, Senate, No. 353) of Bruce E. Tarr for legislation relative to school safety issues.  Education.","DocumentText":"\tSECTION 1. Chapter 71 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting at the end thereof the following new section:-\r\n\tSection 97. School safety resource officer\r\n\tThe commissioner of the Department of Elementary and Secondary Education shall designate an individual within the department to serve as a school safety resource officer. Said individual shall be available to provide schools with information on school safety issues and to evaluate school safety plans.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}