{"Title":"An Act relative to sales tax reduction to 5% ","BillNumber":"S1942","DocketNumber":"SD684","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"BET0","Name":"Bruce E. Tarr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0","ResponseDate":"2023-01-17T17:51:55.49"},"Cosponsors":[{"Id":"BET0","Name":"Bruce E. Tarr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0","ResponseDate":"2023-01-17T17:51:55.49"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1942/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Tarr, a petition (accompanied by bill, Senate, No. 1942) of Bruce E. Tarr for legislation relative to sales tax reduction to 5%.  Revenue.","DocumentText":"\tSECTION 1. Section 2 of chapter 64H of the General Laws is hereby amended by striking the words “6.25 per cent” and inserting in place thereof the words “5 per cent”.\r\n\tSECTION 2. Section 2 of Chapter 64I of the General Laws is hereby amended by striking the words “6.25 per cent” and inserting in place thereof the words “5 per cent”.\r\n\tSECTION 3. The act shall take effect on August 1, 2024.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J26","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J26"},"Votes":[]}],"Amendments":[]}