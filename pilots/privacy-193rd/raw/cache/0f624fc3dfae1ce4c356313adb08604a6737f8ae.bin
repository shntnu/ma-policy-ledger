Name":"David F. DeCoste","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFD1","ResponseDate":"2023-04-05T18:18:49.6166667"},{"Id":"SGX1","Name":"Steven George Xiarhos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2023-06-08T06:49:49.6"},{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-07-05T15:59:35.68"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-11-28T16:00:12.6"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4616/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tSection 32 of chapter 121B of the General Laws, is hereby amended by adding, after the sixth paragraph the following paragraph: \r\n\tIn determining the net income of the tenant family for the purpose of computing the rent and determining eligibility for admission and continued occupancy, payments received by veterans as reimbursement for out-of-pocket health care costs shall be excluded from income.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J31"},"Votes":[]}],"Amendments":[]}