{"Title":"An Act to address mental health and substance use needs","BillNumber":"S1276","DocketNumber":"SD2309","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-01-20T15:32:27.997"},"Cosponsors":[{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-01-20T15:32:27.9966667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1276/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Velis, a petition (accompanied by bill, Senate, No. 1276) of John C. Velis for legislation to address mental health and substance use needs.  Mental Health, Substance Use and Recovery.","DocumentText":"\tChapter 111 of the General Laws, as appearing in the 2020 official edition, is hereby amended by adding the following section:- \r\n\tThere shall be a mental health and substance use disorder grant program established within the department of mental health for the purpose of addressing increased mental health and substance use needs.  \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J18","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J18"},"Votes":[]}],"Amendments":[]}