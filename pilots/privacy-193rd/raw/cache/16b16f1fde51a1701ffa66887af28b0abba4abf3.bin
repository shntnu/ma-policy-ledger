        <!-- MAIN CONTENT -->
        <span id="mainContent" class="sr-only"></span>
        <main>
            
<div class="titleBar clearfix">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-7 col-md-8">
                <ol class="breadcrumb-titleBar">
                    <li class="hidden-print"><a href="/Laws/SessionLaws">Session Laws</a></li>
                    <li><a href="/Laws/SessionLaws/Acts/2024">Acts (2024)</a></li>
                    <li class="visible-print-block"><a href="#">Chapter 406</a></li>
                </ol>
                <h1>Chapter 406</h1>
            </div>
            <div class="hidden-xs col-sm-5 col-md-4">
                <div class="typeahead-wrapper-md"><form action="/Search" method="get">        <h2 class="sr-only">Search the Legislature</h2>
    <label class="sr-only" for="detailSearch">Search the Legislature</label>
    <div class="typeahead-container">
        <div class="typeahead-field">
            <div class="input-group typeahead-query ">
                <input id="detailSearch"
                       name="SearchTerms"
                       class="searchBox form-control"
                       type="search"
                       data-tt-search-type="Bills, GeneralLaws, SessionLaws, Committees, Legislators, Events, Journals, Reports, Videos, Amendments, ClerkContents"
                       data-tt-search-reset="Bills, GeneralLaws, SessionLaws, Committees, Legislators, Events, Journals, Reports, Videos, Amendments, ClerkContents"
                       data-tt-url="/TypeAheadSearch"
                       data-tt-branch=""
                       data-tt-limit="7"
                       aria-haspopup="true"
                       aria-autocomplete="list"
                       autocomplete="off"
                       placeholder="Search the Legislature..." />

                <div class="input-group-btn typeahead-button">
                    <button type="submit" class="btn btn-primary searchButton" aria-label="Search the Legislature">
                                <span class="fa fa-search"></span>
                                <span class="sr-only">Search</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form></div>
            </div>
        </div>
    </div>
</div>
<!-- /TITLEBAR -->

<div class="content">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-md-8">
                <div class="col-xs-12">
                    
<div class="btn-toolbar pull-right" role="toolbar">
    <div class="btn-group" role="group">
        <button class="btn btn-sm btn-secondary printButton" type="button" onclick="javascript:window.print();" aria-haspopup="true"><span class="fa fa-print"></span>&nbsp;Print Page</button>
    </div>
	<div class="btn-group" role="group">
			<button class="btn btn-sm btn-secondary prevButton" onclick="location.href ='/Laws/SessionLaws/Acts/2024/Chapter405';"><span class="fa fa-angle-left"></span> Prev<span class="sr-only">ious</span></button>
	        <button class="btn btn-sm btn-secondary nextButton" onclick="location.href = '/Laws/SessionLaws/Acts/2024/Chapter407';">Next <span class="fa fa-angle-right"></span></button>
	</div>
</div>

                </div>


                <div class="col-xs-12">
                    <h2 class="h3 chapterTitle">AN ACT AMENDING THE CHARTER OF THE CITY OF GARDNER</h2>
                </div>

                <div class="col-xs-12">
                    <p><em>&nbsp;&nbsp;&nbsp;&nbsp;</em>&nbsp;<em>Be it enacted by the Senate and House of Representatives in General Court assembled, and by the authority of the same, as follows:</em><br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;1.&nbsp;&nbsp;Section 4 of chapter 119 of the acts of 1921 is hereby amended by striking out the second sentence and inserting in place thereof the following sentence:- The mayor shall hold office for the term of 2 years from the first Monday in January following the election for mayor and until a successor is elected and qualified.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;2.&nbsp;&nbsp;Section 6 of said chapter 119 is hereby amended by striking out the words "but the city solicitor" and inserting in place thereof the following words:- provided, however, that all members of the law department.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;3.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out section 7 and inserting in place thereof the following section:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;7.&nbsp;&nbsp;In making appointments, the mayor shall sign and file with the city clerk a certificate in either of the forms provided in paragraphs (1) and (2), which shall each be titled &ldquo;certificate of appointment&rdquo;. <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(1)&nbsp;&nbsp;I appoint (name of appointee) to the position of (name of office) and I certify that in my opinion, (name of appointee) is a recognized expert in the work which will devolve in the course of official duties and I make this appointment solely in the interest of the city. <br /> Mayor. <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(2)&nbsp;&nbsp;I appoint (name of appointee) to the position of (name of office) and I certify that in my opinion, (name of appointee) is a person specially fitted by education, training or experience to perform the duties of said office and I make this appointment solely in the interest of the city.<br /> Mayor.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;4.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out section 8 and inserting in place thereof the following section:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;8.&nbsp;&nbsp;The mayor may, with the approval of a majority of the members of the city council, remove any appointed head of a department or member of a board before the expiration of the appointee's term of office, except members of the school committee, officers elected by the city council, officers whose election is provided for by this act and officials appointed by the governor. The person removed shall receive a copy of the reasons for such removal in writing and may contest the same at a hearing to be given by the city council, at which hearing the person removed shall have the right to be represented by counsel.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;5.&nbsp;&nbsp;Section 11 of said chapter 119, as amended by section 1 of chapter 184 of the acts of 1939, is hereby further amended by striking out the first paragraph and inserting in place thereof the following paragraph:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;The mayor shall receive for the mayor&rsquo;s services such salary as the city council, by ordinance, shall determine and shall receive no other compensation from the city. The mayor's salary shall not be increased or diminished during the term to which the mayor was elected.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;6.&nbsp;&nbsp;The first sentence of section 12 of said chapter 119 is hereby amended by striking out the word "third" and inserting in place thereof the following word:- seventh.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;7.&nbsp;&nbsp;The first paragraph of section 13 of said chapter 119 is hereby amended by striking out the first sentence and inserting in place thereof the following sentence:- Any person who is qualified to vote for a candidate for any office mentioned in this act, and who is a candidate for nomination for that office, may have the name as such candidate printed on the official ballot to be used at a preliminary election; provided, however, that, at least 28 days prior to the preliminary election pursuant to section 10 of chapter 53 of the General Laws, the person shall file with the city clerk a statement in writing of such candidacy, together with the petition of not less than 50 voters of the city who are qualified to vote for a candidate for such office. <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;8.&nbsp;&nbsp;Said section 13 of said chapter 119 is hereby amended by striking out the words &ldquo;We further state that we believe him to be of good moral character and qualified to perform the duties of the office.&rdquo; and inserting in place thereof the following sentence:- We further state that we believe this person to be of good moral character and qualified to perform the duties of the office.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;9.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out section 15 and inserting in place thereof the following section:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;15.&nbsp;&nbsp;The name of each person, and of none other, who has filed a statement and an accompanying petition pursuant to this act with the official residence and the title and term of the office for which the individual is a candidate for nomination, shall be printed on ballots under the designation of office in the order in which they may be drawn by the city clerk, whose duty it shall be to make such drawing and to give each candidate an opportunity to be present in person or by 1 representative at such drawing. At the end of a list of candidates for nomination to an office, the city clerk shall leave blank spaces equal in amount to that of the number of such candidates whose names appear on such list; provided, however, that a voter may insert in such blank space the name of a person whose name does not appear on such list for whom the voter desires to vote for nomination to such office. The city clerk shall print on said ballots such directions as will aid the voter, including, but not limited to: (i) "vote for 1"; (ii) "vote for not more than 2"; and (iii) other similar directions as deemed necessary and in accordance with section 42 of chapter 54 of the General Laws.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;10.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out section 16 and inserting in place thereof the following section:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;16.&nbsp;&nbsp;No ballot used at any preliminary, special or regular city election shall have printed thereon any political party or other political designation or mark and there shall not be appended to the name of any candidate any such political party or other political designation or mark or anything showing the method of nomination or indicating the candidate's views or opinions pursuant to section 34 of chapter 53 of the General Laws.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;11.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out section 18 and inserting in place thereof the following section:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;18.&nbsp;&nbsp;The city clerk shall canvas returns from election officers and post them in a conspicuous place in city hall and in other manners consistent with city practices.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;12.&nbsp;&nbsp;The second paragraph of section 19 of said chapter 119 is hereby amended by striking out the second sentence and inserting in place thereof the following sentence:- If 2 or more candidates receive an equal number of votes for the same office at a preliminary election held pursuant to this act and 1 of such candidates would otherwise be entitled to have that candidate's name upon the official ballot, then the names of all such persons shall be placed on the ballot.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;13.&nbsp;&nbsp;Paragraph 3 of section 24 of said chapter 119 is hereby amended by striking out the second sentence and inserting in place thereof the following sentence:- The city clerk shall keep the records of the meetings of the council.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;14.&nbsp;&nbsp;Section 25 of said chapter 119 is hereby amended by striking out the first sentence and inserting in place thereof the following sentence:- The city council may at any time request from the mayor specific information about any municipal matter within its jurisdiction and may request the mayor's presence to answer written questions relating to such matters at a meeting to be held not earlier than 1 week after the date of the receipt by the mayor of said questions.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;15.&nbsp;&nbsp;The first paragraph of section 29 of said chapter 119, as amended by section 1 of chapter 65 of the acts of 1935, is hereby further amended by striking out the words "full in at least one newspaper of the city," and inserting in place thereof the following word:- summary.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;16.&nbsp;&nbsp;Said first paragraph of said section 29 of said chapter 119, as so amended, is hereby further amended by striking out the word "additional".<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;17.&nbsp;&nbsp;The second paragraph of said section 29 of said chapter 119, as so amended, is hereby further amended by inserting after the word "completed" the following words:- in summary.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;18.&nbsp;&nbsp;Said chapter 119 is hereby further amended by striking out sections 30 and 31 and inserting in place thereof the following 2 sections:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;30.&nbsp;&nbsp;An order, ordinance, resolution or vote relative to the affairs of the city, adopted or passed by the city council, shall be presented to the mayor for approval. If the mayor approves, then the mayor shall sign it and, if the mayor disapproves, it shall be returned to the city council with the mayor's objections in writing, which the city council shall enter at large on its records, and again consider the order, ordinance, resolution or vote. If the city council, notwithstanding the disapproval of the mayor, shall again pass such order, ordinance, resolution or vote by a two-thirds vote of all members of the city council, the act shall then be in force and presented to the mayor a second time; provided, however, that such vote shall be taken not less than 7 days after the return of the act to the city council. Such act shall be in force if it is not returned by the mayor within 10 days after it was presented to the mayor a second time. This section shall not apply to budgets submitted pursuant to section 32 of chapter 44 of the General Laws or to appropriations by the city council pursuant to section 33 of said chapter 44.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;31.&nbsp;&nbsp;Civil service laws shall not apply to the appointment of the mayor's secretaries and the appointment of stenographers, clerks, telephone operators and messengers connected with the mayor's office and the mayor may remove such appointees without a hearing and without making a statement of the cause for their removal.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;19.&nbsp;&nbsp;The first paragraph of section 32 of said chapter 119, as amended by section 1 of chapter 590 of the acts of 1975, is hereby further amended by striking out the word "six", each time it appears, and inserting in place thereof, in each instance, the following figure:- 12.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;20.&nbsp;&nbsp;Said section 32 of said chapter 119, as so amended, is hereby further amended by adding the following 2 paragraphs:- <br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;If the mayor is absent or temporarily unable for any reason to perform the duties of the office, or if the office is vacant during the first 12 months of the term, the mayor's duties shall be performed by the president of the city council. The person upon whom such duties shall devolve shall be called "acting mayor", shall possess the powers of mayor only in matters not admitting of delay and shall have no power to make permanent appointments. If the office of the mayor is vacated due to resignation or death prior to the end of the term, the acting mayor shall be entitled to the compensation for city council president in addition to 75 per cent of the rate of compensation for the mayor.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;If an appointive officer of the city is absent or temporarily unable for any reason to perform official duties, the mayor or the city council, whichever has the power of original appointment, may make a temporary appointment of a person to act in place of such appointive officer until the appointive officer resumes duties.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;21.&nbsp;&nbsp;The first paragraph of section 33 of said chapter 119 is hereby amended by striking out the words "his interest in such contract," and inserting in place thereof the following words:- the interest in such contract.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;22.&nbsp;&nbsp;Sections 34 and 35 of said chapter 119 are hereby repealed.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;23.&nbsp;&nbsp;Section 37 of said chapter 119 is hereby amended by striking out the word "chairman" and inserting in place thereof the following word:- chairperson.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;24.&nbsp;&nbsp;The first sentence of section 38 of said chapter 119 is hereby amended by striking out the word "elect" and inserting in place thereof the following word:- appoint.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;25.&nbsp;&nbsp;Said section 38 of said chapter 119 is hereby further amended by striking out the second sentence and inserting in place thereof the following sentence:- No member of the school committee, except the mayor, shall hold any other office or position with a salary or compensation that is payable out of the city treasury during the elected term of office.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;26.&nbsp;&nbsp;The third sentence of said section 38 of said chapter 119 is hereby amended by striking out the word "vice-chairman" and inserting in place thereof the following word:- vice-chairperson.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;27.&nbsp;&nbsp;Section 51 of said chapter 119 is hereby repealed.<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SECTION&nbsp;28.&nbsp;&nbsp;This act shall take effect upon its passage.</p>
<p align="center">Approved, January 10, 2025.</p>
                </div>
            </div>
            <div class="col-xs-12 col-md-4">
