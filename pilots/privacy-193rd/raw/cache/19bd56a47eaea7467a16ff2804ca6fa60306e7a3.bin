{"Title":"An Act relative to heartworm in dogs","BillNumber":"S497","DocketNumber":"SD62","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-01-10T13:16:57.027"},"Cosponsors":[{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-01-10T13:16:57.0266667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S497/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Gobi, a petition (accompanied by bill, Senate, No. 497) of Anne M. Gobi for legislation relative to heartworm in dogs.  Environment and Natural Resources.","DocumentText":"\tSECTION 1: The Massachusetts Department of Agricultural Resources (the Department) shall adopt best practices as put forth by the American Heartworm Association, specifically relative to the transport and acceptance into the Commonwealth of Massachusetts with any stage of dirofilariasis, also known as heartworm or dog heartworm.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J21","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J21"},"Votes":[]}],"Amendments":[]}