},{"AmendmentNumber":"60","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/60/"},{"AmendmentNumber":"61","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/61/"},{"AmendmentNumber":"62","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/62/"},{"AmendmentNumber":"63","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/63/"},{"AmendmentNumber":"64","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/64/"},{"AmendmentNumber":"65","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/65/"},{"AmendmentNumber":"66","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/66/"},{"AmendmentNumber":"67","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/67/"},{"AmendmentNumber":"68","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Senate/Amendments/68/"},{"AmendmentNumber":"69","ParentBillNumber":"S2834","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2834/Branches/Se