e duty.  Veterans and Federal Affairs.","DocumentText":"\tSECTION 1. Section 100A of chapter 32 of the General Laws is hereby amended by inserting after paragraph (j) the following paragraph:-\r\n\t(k) This section shall apply to men and women who die on active duty whether combat related or not.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J31"},"Votes":[]}],"Amendments":[]}