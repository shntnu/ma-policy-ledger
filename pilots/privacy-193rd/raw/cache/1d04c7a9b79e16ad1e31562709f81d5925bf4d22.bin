":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-02-08T13:55:37.5033333"},{"Id":"JRO0","Name":"Jacob R. Oliveira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JRO0","ResponseDate":"2023-04-21T13:54:27.3533333"},{"Id":"PSS1","Name":"Priscila S. Sousa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PSS1","ResponseDate":"2023-02-14T13:12:43.34"},{"Id":"BET0","Name":"Bruce E. Tarr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0","ResponseDate":"2023-04-03T14:07:25.3233333"},{"Id":"MSV1","Name":"Marcus S. Vaughn","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MSV1","ResponseDate":"2023-01-20T17:17:17.5033333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H557/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Pignatelli of Lenox, a petition (accompanied by bill, House, No. 557) of Smitty Pignatelli and others relative to prescription opioid abuse prevention education in public schools.  Education.","DocumentText":"\tSECTION 1. Section 1 of chapter 71 of the general laws, as so appearing in the 2018 edition, is hereby amended by inserting after the word “violence”, in line 22, the following words:- “, prescription opioid abuse prevention, with an emphasis on the prescription drug epidemic and the connection between prescription opioid abuse and addiction to other drugs, such as heroin,”. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}