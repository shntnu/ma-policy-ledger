{"Title":"An Act to establish the Massachusetts National Guard Museum in Salem","BillNumber":"S2335","DocketNumber":"SD1976","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:20:48.74"},"Cosponsors":[{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:20:48.74"},{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-02-08T11:55:47.57"},{"Id":"SSH1","Name":"Steven S. Howitt","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SSH1","ResponseDate":"2023-02-08T11:55:47.57"},{"Id":"N_C0","Name":"Nick Collins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_C0","ResponseDate":"2023-11-01T13:34:34.7266667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2335/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Lovely, a petition (accompanied by bill, Senate, No. 2335) of Joan B. Lovely, John C. Velis and Steven S. Howitt for legislation to establish the Massachusetts National Guard Museum in Salem.  Veterans and Federal Affairs.","DocumentText":"\tChapter 33 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting, after section 139, the following section:-\r\n\tSection 140.  There shall be a permanent museum for the Massachusetts National Guard located in the City of Salem as the federal birthplace of the National Guard.  Furthermore, it shall be recognized as the official military museum for the commonwealth of Massachusetts.  \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J31"},"Votes":[]},{"Action":"Favorable with Amendment","FiscalAmounts":[],"Committee":{"CommitteeCode":"S30","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S30"},"Votes":[{"Question":"Ought to pass – by substitution of a New Draft","Bill":{"BillNumber":"S2335","DocketNumber":"SD1976","Title":"An Act to establish the Massachusetts National Guard Museum in Salem","PrimarySponsor":{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:20:48.74"},"Cosponsors":[{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:20:48.74"},{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-02-08T11:55:47.57"},{"Id":"SSH1","Name":"Steven S. Howitt","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SSH1","ResponseDate":"2023-02-08T11:55:47.57"},{"Id":"N_C0","Name":"Nick Collins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_C0","ResponseDate":"2023-11-01T13:34:34.7266667"}],"JointSponsor":null,"GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2335","IsDocketBookOnly":false},"Committee":{"CommitteeCode":"S30","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S30"},"Date":"2024-12-17T14:00:00","Vote":[{"Favorable":[{"GeneralCourtNumber":193,"MemberCode":"MJR0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MJR0"},{"GeneralCourtNumber":193,"MemberCode":"CFF0","Details":"https://malegislature.gov/api/Gen