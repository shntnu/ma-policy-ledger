{"Title":"An Act relative to the transportation of marine vessels","BillNumber":"H5129","DocketNumber":"HD5495","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"KAD1","Name":"Kip A. Diggs","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KAD1","ResponseDate":"2024-11-14T14:41:18.77"},"Cosponsors":[{"Id":"KAD1","Name":"Kip A. Diggs","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KAD1","ResponseDate":"2024-11-14T14:41:18.7833333"},{"Id":"JAC0","Name":"Julian Cyr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAC0","ResponseDate":"2024-11-14T15:49:02.9866667"}],"JointSponsor":{"Id":"JAC0","Name":"Julian Cyr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAC0","ResponseDate":"2024-11-14T15:48:22.51"},"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5129/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Diggs of Barnstable and Senator Cyr, a joint petition (subject to Joint Rule 12) of Kip A. Diggs and Julian Cyr relative to the transportation of marine vessels.  Transportation.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the maximum height and width dimensions as provided in sections 19 or 19A of chapter 90 shall not apply to any vessel being hauled from or back to a professional waterfront year round marine servicing business in the villages of Hyannis or Osterville and trucked by a professional licensed boat hauler on a public way within 3 miles of its waterfront location of origin in the town of Barnstable and which may pass over the roadways of the town of Yarmouth\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]},{"Action":"Favorable with Amendment","FiscalAmounts":[],"Committee":{"CommitteeCode":"H34","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H34"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H5129","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5129/Branches/House/Amendments/1/"}]}