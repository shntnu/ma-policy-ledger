mber":193,"MemberCode":"PMO","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO"},{"GeneralCourtNumber":193,"MemberCode":"PJD0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJD0"}],"Adverse":[],"ReserveRight":[{"GeneralCourtNumber":193,"MemberCode":"RCF0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0"}],"NoVoteRecorded":[{"GeneralCourtNumber":193,"MemberCode":"A_G0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/A_G0"}]}]}]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"S2551","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2551/Branches/Senate/Amendments/1/"},{"AmendmentNumber":"1","ParentBillNumber":"S2457","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2457/Branches/Senate/Amendments/1/"},{"AmendmentNumber":"2","ParentBillNumber":"S2551","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2551/Branches/Senate/Amendments/2/"}]}