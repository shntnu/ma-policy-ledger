{"Title":"An Act Dracut Water Supply District distribution","BillNumber":"H5115","DocketNumber":"HD5253","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CMG1","Name":"Colleen M. Garry","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMG1","ResponseDate":"2024-07-09T16:44:57.73"},"Cosponsors":[{"Id":"CMG1","Name":"Colleen M. Garry","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMG1","ResponseDate":"2024-07-09T16:44:57.73"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5115/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Garry of Dracut, a petition (subject to Joint Rule 12) of Colleen M. Garry that the Dracut water supply district be authorized to supply and sell water for domestic and other purposes.  Environment and Natural Resources.","DocumentText":"\tThe Dracut water supply district, established in section 1 of chapter 433 of the acts of 1905, may supply and sell water for domestic and other purposes to the town of Pelham, New Hampshire or a water district servicing the town, the town of Hudson, New Hampshire or a water district servicing the town and to the Kenwood water district of the town of Dracut. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]}],"Amendments":[]}