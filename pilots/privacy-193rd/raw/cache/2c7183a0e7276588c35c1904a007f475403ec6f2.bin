{"Title":"An Act promoting access to counsel and housing stability in Massachusetts","BillNumber":"H1731","DocketNumber":"HD3657","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DMR1","Name":"David M. Rogers","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DMR1","ResponseDate":"2023-01-20T13:33:52.49"},"Cosponsors":[{"Id":"DMR1","Name":"David M. Rogers","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DMR1","ResponseDate":"2023-01-20T13:33:52.49"},{"Id":"MSD1","Name":"Michael S. Day","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MSD1","ResponseDate":"2023-01-20T14:09:16.9933333"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-02-08T16:29:26.2666667"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-07-11T10:17:00.9466667"},{"Id":"SBA1","Name":"Shirley B. Arriaga","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SBA1","ResponseDate":"2023-05-09T13:28:47.5366667"},{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-01-31T16:04:19.77"},{"Id":"RBB1","Name":"Ruth B. Balser","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RBB1","ResponseDate":"2023-02-23T12:28:44.9733333"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-02-24T12:49:53.07"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-02-20T16:38:11.23"},{"Id":"PLC1","Name":"Peter Capano","Type":1,"Detai