.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-02-12T21:25:06.69"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-02-13T14:15:08.8733333"},{"Id":"WCG1","Name":"William C. Galvin","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WCG1","ResponseDate":"2023-02-13T14:15:08.89"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-02-17T15:52:02.5466667"},{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-03-02T19:37:04.0833333"},{"Id":"MPK1","Name":"Michael P. Kushmerek","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MPK1","ResponseDate":"2023-03-07T08:42:18.78"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-03-28T16:46:28.38"},{"Id":"K_K1","Name":"Kay Khan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_K1","ResponseDate":"2023-03-29T08:52:48.7433333"},{"Id":"KIG1","Name":"Kenneth I. Gordon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KIG1","ResponseDate":"2023-04-04T14:37:31.3433333"},{"Id":"PMO","Name":"Patrick M. O'Connor","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-04-04T14:37:31.3433333"},{"Id":"MCD1","Name":"Marjorie C. Decker","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCD1","ResponseDate":"2023-05-10T13:33:11.69"},{"Id":"ERP1","Name":"Edward R. Philips","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/ERP1","ResponseDate":"2023-06-16T10:12:27.38"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-06-28T23:11:33.0366667"},{"Id":"DCG1","Name":"Denise C. Garlick","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DCG1","ResponseDate":"2023-07-21T12:33:03.4"},{"Id":"M_C2","Name":"Michelle L. Ciccolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C2","ResponseDate":"2023-07-21T12:33:03.4"},{"Id":"DAS1","Name":"Danillo A. Sena","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DAS1","ResponseDate":"2023-08-31T10:38:34.82"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-10-16T09:30:39.0766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H529/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Lewis of Framingham, a petition (accompanied by bill, House, No. 529) of Jack Patrick Lewis and others relative to the teaching of Native American culture and history.  Education.","DocumentText":"\tThe third paragraph of section 1D of chapter 69 of the General Laws, as appearing in the 2018 Official Edition, is hereby amended by inserting after the second sentence the following sentence:- The standards shall provide for instruction in: (i) tribal history and current issues of the Aquinnah Wampanoag, Mashpee Wampanoag and other Wampanoag tribes, the Massachuset, the Nipmuc and other Native American tribes that exist within Massachusetts; (ii) information about tribes and confederacies that have historic ties to Massachusetts, such as the Wabanaki Confederacy; (iii) tribal history of Native Americans throughout the United States; (iv) tribal sovereignty and governance, treaty rights, genocide, Native American cultures, languages and socioeconomic experiences; and (v) ongoing issues common to contemporary Native Americans throughout Massachusetts; provided, that to develop these standards the board shall consult consistently with the special relationship between the Commonwealth and Native Americans as molded by Treaty and Agreement, Legislative Act and Executive Order.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}