":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2023-04-03T14:01:32.1333333"},{"Id":"WFT0","Name":"Walter F. Timilty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WFT0","ResponseDate":"2023-04-13T13:01:00.3633333"},{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-06-21T12:48:14.62"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1730/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Rush, a petition (accompanied by bill, Senate, No. 1730) of Michael F. Rush, Paul McMurtry, Joanne M. Comerford, Bruce E. Tarr and other members of the General Court for legislation to include certain certified emergency telecommunicators in Group 2 of the contributory retirement system for public employees.  Public Service.","DocumentText":"\tChapter 32, Section 3, paragraph G, “Group 2” of the Massachusetts General Laws is hereby amended by inserting in line 283 after the words “Cushing hospital” the following:-\r\n\t\"; and all full time Dispatchers, Dispatch Supervisors, Communications Center Directors or Communications Chiefs certified by the Commonwealth of Massachusetts State 911 Department as Certified Telecommunicators as defined by MA 560 CMR 5.04\".\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}