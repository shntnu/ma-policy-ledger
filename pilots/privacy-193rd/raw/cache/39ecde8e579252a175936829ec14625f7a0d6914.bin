{"Title":"An Act establishing a sick leave bank for David Benway, an employee of the Massachusetts Maritime Academy","BillNumber":"H3739","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J23","Name":"Joint Committee on Public Service","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23","ResponseDate":"2023-04-07T10:20:33.64"},"Cosponsors":[{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-02-16T12:21:42.8366667"},{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-02-16T12:21:42.8366667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3739/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tNotwithstanding any general or special law to the contrary, the Massachusetts Maritime Academy shall establish a sick leave bank for David Benway, an employee of the Academy. Any employee of the Academy may voluntarily contribute 1 or more sick, personal, or vacation days to the sick leave bank for use by David Benway. If David Benway terminates employment with the Academy or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the Academy. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"S31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S31"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H3739","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3739/Branches/House/Amendments/1/"}]}