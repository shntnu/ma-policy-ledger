{"Title":"An Act to address arbitration agreements\r\n","BillNumber":"H1654","DocketNumber":"HD2826","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J_L1","Name":"Jay D. Livingstone","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_L1","ResponseDate":"2023-01-19T16:46:35.84"},"Cosponsors":[{"Id":"J_L1","Name":"Jay D. Livingstone","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_L1","ResponseDate":"2023-01-19T16:46:35.84"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H1654/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Livingstone of Boston, a petition (accompanied by bill, House, No. 1654) of Jay D. Livingstone relative to arbitration agreements.  The Judiciary.","DocumentText":"\tSECTION 1: Section 32 of chapter 260 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting after “matter of form,” the following: “or a dismissal as a result of an arbitration agreement,”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}