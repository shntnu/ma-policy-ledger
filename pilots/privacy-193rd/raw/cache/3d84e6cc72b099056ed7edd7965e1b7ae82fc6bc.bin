{"Title":"An Act banning the retail sale of dogs, cats, and rabbits in new pet shops","BillNumber":"S2820","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J21","Name":"Joint Committee on Environment and Natural Resources","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J21","ResponseDate":"2024-06-12T12:21:30.97"},"Cosponsors":[{"Id":"PMO","Name":"Patrick M. O'Connor","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-01-19T15:31:16.3766667"},{"Id":"N_H1","Name":"Natalie M. Higgins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_H1","ResponseDate":"2023-01-18T11:50:32.5666667"},{"Id":"KNF1","Name":"Kimberly N. Ferguson","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KNF1","ResponseDate":"2023-01-18T11:50:32.5666667"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-01-20T14:24:45.76"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-26T11:18:18.29"},{"Id":"MOM0","Name":"Michael O. Moore","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MOM0","ResponseDate":"2023-02-02T14:15:09.8466667"},{"Id":"AJP1","Name":"Angelo J. Puppolo, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJP1","ResponseDate":"2023-02-06T11:54:11.9766667"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-27T10:02:15.5566667"},{"Id":"JFK0","Name":"John F. Keenan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JFK0","ResponseDate":"2023-02-14T11:40:23.69"},{"Id":"BWM1","Na