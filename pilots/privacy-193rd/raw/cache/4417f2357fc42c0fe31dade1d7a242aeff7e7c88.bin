{"Title":"An Act relative to updating animal health inspections","BillNumber":"S1311","DocketNumber":"SD2179","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-01-09T13:17:26.247"},"Cosponsors":[{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-01-09T13:17:26.2466667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1311/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Montigny, a petition (accompanied by bill, Senate, No. 1311) of Mark C. Montigny for legislation relative to updating animal health inspections.  Municipalities and Regional Government.","DocumentText":"\tSECTION 1.  Section 39A of chapter 129 of the General Laws, as appearing in the 2020 Official Edition, is amended by striking the second paragraph and inserting in place thereof the following:-\r\n\t\"This section shall not apply to a publicly or privately owned zoological park, a research institution as defined in section 136A of chapter 140, or to horse or cattle auctions.\".\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]}],"Amendments":[]}