{"Title":"An Act relative to small businesses and homeowners","BillNumber":"S1767","DocketNumber":"SD2409","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"N_C0","Name":"Nick Collins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_C0","ResponseDate":"2023-01-20T16:59:34.577"},"Cosponsors":[{"Id":"N_C0","Name":"Nick Collins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_C0","ResponseDate":"2023-01-20T16:59:34.5766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1767/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Collins, a petition (accompanied by bill, Senate, No. 1767) of Nick Collins for legislation relative to small businesses and homeowners.  Revenue.","DocumentText":"\tIncome generated from one-time sales of small businesses of residential properties shall be exempt of the application of the surtax XLIV of the Massachusetts constitution as most recently amended. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J26","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J26"},"Votes":[]}],"Amendments":[]}