{"Title":"An Act amending the charter of the town of Wareham","BillNumber":"S2816","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MRP0","Name":"Marc R. Pacheco","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRP0","ResponseDate":"2024-06-10T08:05:04.42"},"Cosponsors":[{"Id":"MRP0","Name":"Marc R. Pacheco","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRP0","ResponseDate":"2024-06-10T08:05:04.4366667"},{"Id":"SWG1","Name":"Susan Williams Gifford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SWG1","ResponseDate":"2023-11-14T16:34:16.1166667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2816/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"Senate, June 10, 2024 -- Substituted as a new draft (Senator Pacheco) for the Senate Bill relative to the Wareham town charter (Senate, No. 2519).","DocumentText":"\tSECTION 1. Article 3 of the charter of the town of Wareham, which is on file in the office of the archivist of the commonwealth, as provided in section 12 of chapter 43B of the General Laws,  is hereby amended by striking out section 3-9. \r\n\tSECTION 2. Section 5-3 of article 5 of said charter is hereby amended by striking out the words “January 25” and inserting in place thereof the following words:- \"February 28.”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"S31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S31"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]}],"Amendments":[]}