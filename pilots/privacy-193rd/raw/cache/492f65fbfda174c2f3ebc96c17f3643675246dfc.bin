{"Title":"An Act relating to guardians of surviving children of emergency first responders","BillNumber":"H2710","DocketNumber":"HD2663","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"D_B1","Name":"David Biele","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/D_B1","ResponseDate":"2023-01-19T15:21:33.177"},"Cosponsors":[{"Id":"D_B1","Name":"David Biele","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/D_B1","ResponseDate":"2023-01-19T15:21:33.1766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H2710/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Biele of Boston, a petition (accompanied by bill, House, No. 2710) of David Biele for legislation to authorize the abatement of certain real estate taxes for surviving spouses or guardians of children of emergency first responders or corrections officers killed in the line of duty.  Revenue.","DocumentText":"\tNotwithstanding section 5 of chapter 59 of the General Laws, or any other general or special law to the contrary, any city, town, or political subdivision of the commonwealth may grant abatement of the real estate taxes assessed upon the property owned and occupied by the surviving spouse or guardian of a child whose parent was an emergency first responder or corrections officer killed in the line of duty as such, provided that such real estate is occupied by the child as his or her domicile.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J26","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J26"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]}],"Amendments":[]}