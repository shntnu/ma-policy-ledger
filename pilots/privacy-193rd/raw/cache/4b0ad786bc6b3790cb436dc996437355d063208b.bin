{"Title":"An Act relative formalizing Title V and Watershed regulations","BillNumber":"H3854","DocketNumber":"HD2315","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CRF1","Name":"Christopher Richard Flanagan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CRF1","ResponseDate":"2023-01-19T12:17:46.58"},"Cosponsors":[{"Id":"CRF1","Name":"Christopher Richard Flanagan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CRF1","ResponseDate":"2023-01-19T12:17:46.58"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3854/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Flanagan of Dennis, a petition (accompanied by bill, House, No. 3854) of Christopher Richard Flanagan that the Department of Environmental Protection provide certain variances to municipalities with comprehensive wastewater management plans.  Environment and Natural Resources.","DocumentText":"\tSection 13 of chapter 21A of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting after the first paragraph the following paragraph:-\r\n\tThe commissioner of the department of environmental protection shall provide for variances from the requirements of the state environmental code to municipalities with a comprehensive wastewater management plan in effect that has been approved by the department of environmental protection.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J21","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J21"},"Votes":[]}],"Amendments":[]}