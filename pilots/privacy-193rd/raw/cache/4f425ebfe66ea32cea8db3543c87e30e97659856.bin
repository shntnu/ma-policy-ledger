<script>
    $("#Year").change(function () {
        changePage();
    });
    function changePage() {
        var elementsToReplace = '#replaceContent';
        var elementsTofade = 'ul';

        fadeOutContent(elementsTofade);

        var url;

            url = '/Laws/SessionLaws';

        url += "/" + 'Acts' + '/' + $('#Year').val();

        var newTitle = document.title.replace(/[0-9]/g, '') + $('#Year').val();
        document.title = newTitle;

        history.pushState(true, null, url);
        ExecuteAction(this, elementsToReplace, url, null, false, function () { fadeInContent(elementsTofade); });
        return false;
    }
</script>

