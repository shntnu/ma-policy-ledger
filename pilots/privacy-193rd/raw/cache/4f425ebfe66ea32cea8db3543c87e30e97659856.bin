<div class="content">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-md-8">
                <h2 class="hidden-print">
                    <label class="sr-only" for="Year">Year</label>
                    <select class="yearSelect" data-val="true" data-val-required="The Year field is required." id="Year" name="Year"><option value="2026">2026</option>
<option value="2025">2025</option>
<option selected="selected" value="2024">2024</option>
<option value="2023">2023</option>
<option value="2022">2022</option>
<option value="2021">2021</option>
<option value="2020">2020</option>
<option value="2019">2019</option>
<option value="2018">2018</option>
<option value="2017">2017</option>
<option value="2016">2016</option>
<option value="2015">2015</option>
<option value="2014">2014</option>
<option value="2013">2013</option>
<option value="2012">2012</option>
<option value="2011">2011</option>
<option value="2010">2010</option>
<option value="2009">2009</option>
<option value="2008">2008</option>
<option value="2007">2007</option>
<option value="2006">2006</option>
<option value="2005">2005</option>
<option value="2004">2004</option>
<option value="2003">2003</option>
<option value="2002">2002</option>
<option value="2001">2001</option>
<option value="2000">2000</option>
<option value="1999">1999</option>
<option value="1998">1998</option>
<option value="1997">1997</option>
</select>
                </h2>
                
                    
<ul class="sessionLawsList" id="replaceContent">
<li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter1" class="chapter">Chapter 1</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter1" class="lawTitle">AN ACT PROVIDING FOR THE APPOINTMENT OF ASSOCIATE MEMBERS OF THE PLANNING BOARD OF THE TOWN OF SHUTESBURY TO FILL VACANCIES ON THE BOARD.</a>
            (see <a href="/Bills/193/H4038" class="bill">House, No. H.4038&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 8, 2024</span>
    </span>
</li><li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter2" class="chapter">Chapter 2</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter2" class="lawTitle">AN ACT AUTHORIZING THE CITY OF HAVERHILL TO APPOINT RETIRED POLICE OFFICERS AS DETAIL POLICE OFFICERS </a>
            (see <a href="/Bills/193/H2677" class="bill">House, No. H.2677&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 16, 2024</span>
    </span>
</li><li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter3" class="chapter">Chapter 3</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter3" class="lawTitle">AN ACT ESTABLISHING A SENIOR PROPERTY TAX DEFERRAL PROGRAM IN THE CITY OF TAUNTON</a>
            (see <a href="/Bills/193/S2517" class="bill">Senate, No. S.2517&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 19, 2024</span>
    </span>
</li><li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter4" class="chapter">Chapter 4</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter4" class="lawTitle">AN ACT AUTHORIZING MATTHEW K. SONNABEND TO PURCHASE CREDITABLE SERVICE FROM THE BARNSTABLE COUNTY RETIREMENT BOARD</a>
            (see <a href="/Bills/193/H3643" class="bill">House, No. H.3643&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 19, 2024</span>
    </span>
</li><li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter5" class="chapter">Chapter 5</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter5" class="lawTitle">AN ACT AUTHORIZING THE TOWN OF NORTH READING TO USE A PORTION OF CONSERVATION LAND FOR PUBLIC WAY PURPOSES</a>
            (see <a href="/Bills/193/H4169" class="bill">House, No. H.4169&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 19, 2024</span>
    </span>
</li><li>
    <a href="/Laws/SessionLaws/Acts/2024/Chapter6" class="chapter">Chapter 6</a>
    <span class="sessionLaw">
        <a href="/Laws/SessionLaws/Acts/2024/Chapter6" class="lawTitle">AN ACT GRANTING AN ADDITIONAL LIQUOR LICENSE FOR THE SALE OF ALL ALCOHOLIC BEVERAGES TO BE DRUNK ON THE PREMISES IN THE TOWN OF CHATHAM</a>
            (see <a href="/Bills/193/H4189" class="bill">House, No. H.4189&nbsp;</a>)
        <span class="governor">Approved by the Governor, January 25, 2024</span>
