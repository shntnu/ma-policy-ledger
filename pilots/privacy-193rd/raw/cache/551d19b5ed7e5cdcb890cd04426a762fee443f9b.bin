{"Title":"An Act relative to tobacco harm-reduction","BillNumber":"H2141","DocketNumber":"HD572","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DFC1","Name":"Daniel Cahill","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFC1","ResponseDate":"2023-01-13T15:01:01.83"},"Cosponsors":[{"Id":"DFC1","Name":"Daniel Cahill","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFC1","ResponseDate":"2023-01-13T15:01:01.83"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H2141/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Cahill of Lynn, a petition (accompanied by bill, House, No. 2141) of Daniel Cahill relative to tobacco harm-reduction.  Public Health.","DocumentText":"\tSECTION 1. Section 28(b) of Chapter 270 of the General Laws is hereby amended by inserting after the word \"consumption\" the following words:-\r\n\t\"or to any tobacco product that receives an order from the United States Food and Drug Administration under U.S.C., chapter 387j or an order under chapter 387k (g)\".\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J16","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J16"},"Votes":[]}],"Amendments":[]}