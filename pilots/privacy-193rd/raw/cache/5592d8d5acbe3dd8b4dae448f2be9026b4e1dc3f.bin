{"Title":"An Act relative to the Cotuit Fire District","BillNumber":"H5089","DocketNumber":"HD5432","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"KAD1","Name":"Kip A. Diggs","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KAD1","ResponseDate":"2024-08-20T16:00:26.827"},"Cosponsors":[{"Id":"KAD1","Name":"Kip A. Diggs","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KAD1","ResponseDate":"2024-08-20T16:00:26.8266667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5089/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Diggs of Barnstable, a petition (subject to Joint Rule 12) of Kip A. Diggs relative to the Cotuit Fire District.  Municipalities and Regional Government.","DocumentText":"\tChapter 328 of the acts of 1926, as most recently amended by chapter 26 of the acts of 2000, is hereby further amended by inserting after section 5H the following section:-\r\n\tSection 5I. The board of water commissioners may recommend improvements on private property, with prior written approval of the property owners, and seek funds by vote of the district, to protect and enhance the quality of the water supply for the benefit of the residents of Cotuit.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]}],"Amendments":[]}