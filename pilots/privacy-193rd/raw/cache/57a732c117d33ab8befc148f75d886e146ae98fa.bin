{"Title":"An Act insuring adequate minimum school aid","BillNumber":"H448","DocketNumber":"HD108","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-01-06T12:57:38.91"},"Cosponsors":[{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-01-06T12:57:38.91"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H448/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Cutler of Pembroke, a petition (accompanied by bill, House, No. 448) of Josh S. Cutler relative to the minimum amount of school aid available to municipalities.  Education.","DocumentText":"\tSection 2 of Chapter 70 of the General Laws is hereby amended by striking the definition of “Minimum aid” and inserting in place thereof the following:-\r\n\t''Minimum aid'', the amount of minimum state school aid available to a municipality in any fiscal year shall be no less than one hundred dollars multiplied by the district foundation enrollment.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}