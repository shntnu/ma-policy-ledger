neralCourts/193/LegislativeMembers/CRF1","ResponseDate":"2023-03-22T10:30:26.14"},{"Id":"RAM1","Name":"Rita A. Mendes","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RAM1","ResponseDate":"2024-01-26T23:35:17.7733333"},{"Id":"JAG1","Name":"Jessica Ann Giannino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAG1","ResponseDate":"2024-01-26T23:35:17.7733333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H2443/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Biele of Boston, a petition (accompanied by bill, House, No. 2443) of David Biele and others for legislation to expand the cancer presumption for firefighters.  Public Service.","DocumentText":"\tSection 1.  Notwithstanding the provisions of any general or special law to the contrary, Chapter 32 Section 94B(2) of the General Laws as appearing in the 2014 Official Edition is hereby amended by striking the word five in line 27 and insert the word ten after the word within in line 27.\r\n\tSection 2. Chapter 32 Section 94B (2) of the General Laws as appearing in the 2014 Official Edition is hereby amended by inserting in line 31 after the word compensation the following words, in the event that such person retires in accordance with this section any secondary cancer shall be covered in accordance with section 9 of this chapter.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}