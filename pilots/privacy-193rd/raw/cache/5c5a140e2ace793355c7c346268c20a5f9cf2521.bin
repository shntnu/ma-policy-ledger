{"Title":"An Act relative to the Underground Storage Tank Petroleum Cleanup Fund Administrative Review Board","BillNumber":"S504","DocketNumber":"SD110","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-01-10T15:45:43.257"},"Cosponsors":[{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-01-10T15:45:43.2566667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S504/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Gobi, a petition (accompanied by bill, Senate, No. 504) of Anne M. Gobi for legislation relative to the Underground Storage Tank Petroleum Cleanup Fund Administrative Review Board.  Environment and Natural Resources.","DocumentText":"\tSECTION 1: Section 8 of Chapter 21J of the Massachusetts General Laws is hereby amended by striking out the words “Massachusetts Petroleum Council” and inserting in place thereof the words “American Petroleum Institute or its successor”  \r\n\tSECTION 2: Said section is further amended by inserting after the words “New England Convenience Store and Energy Marketers Association, Inc.” the words “or its successor” \r\n\tSECTION 3: Said section is further amended by inserting after the words “New England Service Station and Automotive Repair Association” the words “or its successor”  \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J21","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J21"},"Votes":[]}],"Amendments":[]}