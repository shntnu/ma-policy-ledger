{"Title":"An Act relative to the Wareham town charter","BillNumber":"S2519","DocketNumber":"SD2862","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MRP0","Name":"Marc R. Pacheco","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRP0","ResponseDate":"2023-11-14T16:32:59.75"},"Cosponsors":[{"Id":"MRP0","Name":"Marc R. Pacheco","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRP0","ResponseDate":"2023-11-14T16:32:59.75"},{"Id":"SWG1","Name":"Susan Williams Gifford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SWG1","ResponseDate":"2023-11-14T16:34:16.1166667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2519/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Pacheco, a petition (accompanied by bill, Senate, No. 2519) of Marc R. Pacheco and Susan Williams Gifford (by vote of the town) for legislation relative to the Wareham town charter.  Municipalities and Regional Government.  [Local Approval Received.]","DocumentText":"\tNotwithstanding any general or special law to the contrary, Section 3-9 of the Town of Wareham’s charter, as last amended by Chapter 435 of the Acts of 2022, is hereby rescinded.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[{"Description":"S2519 -- Wareham","DownloadUrl":"http://malegislature.gov/api/DownloadReport?attachmentId=17362&title=S2519%20--%20Wareham"}],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"S2519","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2519/Branches/Senate/Amendments/1/"}]}