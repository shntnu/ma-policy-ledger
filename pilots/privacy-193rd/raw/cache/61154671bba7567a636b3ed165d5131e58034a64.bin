{"Title":"An Act providing school building assistance for Special Education Collaboratives","BillNumber":"S331","DocketNumber":"SD1057","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JRO0","Name":"Jacob R. Oliveira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JRO0","ResponseDate":"2023-01-18T19:43:36.617"},"Cosponsors":[{"Id":"JRO0","Name":"Jacob R. Oliveira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JRO0","ResponseDate":"2023-01-18T19:43:36.6166667"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-03-31T12:05:13.9733333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S331/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Oliveira, a petition (accompanied by bill, Senate, No. 331) of Jacob R. Oliveira for legislation to provide school building assistance for Special Education Collaboratives.  Education.","DocumentText":"\tSection 2 of Chapter 70B of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking the following phrase:- \r\n\t“Eligible applicant”, a city, town, regional school district or independent agricultural and technical school.\r\n\tAnd inserting in place thereof the following:-\r\n\t“Eligible applicant'', a city, town, regional school district or independent agricultural, technical school and Collaborative.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}