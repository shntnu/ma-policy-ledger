{"Title":"An Act relative to improved headlight safety","BillNumber":"S2268","DocketNumber":"SD1926","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PWM0","Name":"Paul W. Mark","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PWM0","ResponseDate":"2023-01-20T07:04:56.463"},"Cosponsors":[{"Id":"PWM0","Name":"Paul W. Mark","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PWM0","ResponseDate":"2023-01-20T07:04:56.4633333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2268/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Mark, a petition (accompanied by bill, Senate, No. 2268) of Paul W. Mark for legislation to improve headlight safety.  Transportation.","DocumentText":"\tSection 7 of Chapter 90 is hereby amended by inserting: \r\n\tAll new automobiles sold in the Commonwealth after January 1, 2026, shall be equipped with adaptive beam headlight technology, as authorized by the amendment to the Federal Motor Vehicle Safety Standard No. 108 by the U.S. Department of Transportation’s National Highway Traffic Safety Administration.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]}],"Amendments":[]}