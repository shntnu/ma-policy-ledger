{"Title":"An Act relative to the Hall-Whitaker Bridge","BillNumber":"S2263","DocketNumber":"SD1985","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:27:10.593"},"Cosponsors":[{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-01-20T11:27:10.5933333"},{"Id":"JAP1","Name":"Jerald A. Parisella","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAP1","ResponseDate":"2023-01-20T11:27:36.05"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2263/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Lovely, a petition (accompanied by bill, Senate, No. 2263) of Joan B. Lovely and Jerald A. Parisella for legislation relative to the Hall-Whitaker Bridge.  Transportation.","DocumentText":"\tSECTION 1. Notwithstanding any general or special law to the contrary, any agency of the commonwealth that receives an application from the Department of Transportation relating to the construction and/or replacement of the Hall-Whitaker Bridge, located in the city of Beverly, must render a decision on such application within sixty days of the receipt of the application.\r\n\tSECTION 2. This act shall take effect upon its passage.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]}],"Amendments":[]}