{"Title":"An Act to protect the collective bargaining rights of certain administrative employees","BillNumber":"H4137","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J43","Name":"Joint Committee on Labor and Workforce Development","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43","ResponseDate":"2023-10-17T12:35:21.5"},"Cosponsors":[{"Id":"D_B1","Name":"David Biele","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/D_B1","ResponseDate":"2023-01-19T15:16:34.2533333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4137/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tSection 1 of chapter 150E of the general laws is hereby amended by inserting after the second sentence of the definition of “employee” the following sentence:  No person employed by the commonwealth in the Management Classification Series below the level of M-VI shall be excluded from the coverage of this chapter unless either the department of labor relations has determined that the actual duties of the particular position or positions meet the test of a managerial employee established in this paragraph or an agreement exists with the exclusive representative of the bargaining unit that covers similar types of work.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J43","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43"},"Votes":[]},{"Action":"Favorable with Amendment","FiscalAmounts":[],"Committee":{"CommitteeCode":"H34","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H34"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H4137","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4137/Branches/House/Amendments/1/"}]}