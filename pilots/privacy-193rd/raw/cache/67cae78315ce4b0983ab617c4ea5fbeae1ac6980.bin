lature.gov/api/GeneralCourts/193/LegislativeMembers/M_C2","ResponseDate":"2023-03-06T09:23:59.8733333"},{"Id":"BHJ1","Name":"Bradley H. Jones, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BHJ1","ResponseDate":"2023-03-31T13:18:55.0533333"},{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-06-30T15:25:01.97"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3243/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Cruz of Salem, a petition (accompanied by bill, House, No. 3243) of Manny Cruz and others relative to tourism and visitation marketing and promotion grants.  Tourism, Arts and Cultural Development.","DocumentText":"\tChapter 23A is hereby amended by adding the following new section:- \r\n\tSection 69. Grants allocated to regional tourism councils through the Massachusetts Tourism Trust Fund established in section 13T in chapter 23A shall be distributed not later than September 1 of the fiscal year for which they are allocated. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J30","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J30"},"Votes":[]}],"Amendments":[]}