{"Title":"An Act to increase kennel safety, aka Ollie's Law","BillNumber":"H4564","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J10","Name":"Joint Committee on Municipalities and Regional Government","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10","ResponseDate":"2024-04-16T12:28:56.82"},"Cosponsors":[{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-01-19T13:41:51.0733333"},{"Id":"DWG1","Name":"Danielle W. Gregoire","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DWG1","ResponseDate":"2023-01-19T13:35:59.52"},{"Id":"RME1","Name":"Rodney M. Elliott","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RME1","ResponseDate":"2023-01-20T16:30:58.56"},{"Id":"SGX1","Name":"Steven George Xiarhos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2023-01-31T13:37:52.7633333"},{"Id":"AJP1","Name":"Angelo J. Puppolo, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJP1","ResponseDate":"2023-01-20T17:41:40.7033333"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-01-23T06:30:21.3333333"},{"Id":"G_C2","Name":"Gerard J. Cassidy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/G_C2","ResponseDate":"2023-01-23T11:46:14.2633333"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-01-24T16:45:09.4166667"},{"Id":"BHJ1","Name":"Bradley H. Jones, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BHJ1","ResponseDate":"2023-01-24T16:45:22.2266667"},{"Id":"BWM1","Name":"Brian 