{"CommitteeCode":"H36","FullName":"House Committee on Bills in the Third Reading","ShortName":"Bills in the Third Reading (H)","Description":"It shall be the duty of the committee on Bills in the Third Reading to consider all bills and resolves prior to their final reading, and examine, correct and recommend such amendments as may be necessary concerning duplication, grammatical errors, constitutionality, etc. The committee shall consider all amendments received from the Senate. The committee shall also act in relation to resolutions and proposals, and any other matters referred thereto. ","Branch":"House of Representatives","GeneralCourtNumber":193,"SenateChairperson":null,"HouseChairperson":{"GeneralCourtNumber":193,"MemberCode":"TJW1","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TJW1"},"DocumentsBeforeCommittee":[{"BillNumber":"H3646","DocketNumber":"HD2320","Title":"An Act directing the Worcester Regional Retirement System to grant creditable service to Nelson Burlingame","PrimarySponsor":{"Id":"PJD2","Name":"Peter J. Durant","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJD2","ResponseDate":"2023-01-17T10:58:12.2233333"},"Cosponsors":[{"Id":"PJD2","Name":"Peter J. Durant","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJD2","ResponseDate":"2023-01-17T10:58:12.2233333"}],"JointSponsor":null,"GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3646","IsDocketBookOnly":false},{"BillNumber":"S2369","DocketNumber":"SD2481","Title":"An Act relative to the retirement of Greg Heath, a former firefighter of the city of Westfield","PrimarySponsor":{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-03-01T13:27:11.5333333"},"Cosponsors":[{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/