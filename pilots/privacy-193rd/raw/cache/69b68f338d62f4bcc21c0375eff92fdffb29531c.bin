eMembers/L_S1","ResponseDate":"2023-01-31T11:42:25.5366667"},{"Id":"PSS1","Name":"Priscila S. Sousa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PSS1","ResponseDate":"2023-02-14T09:57:08.3933333"},{"Id":"TMS1","Name":"Thomas M. Stanley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS1","ResponseDate":"2023-02-09T09:01:45.0133333"},{"Id":"S_G2","Name":"Steven Ultrino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G2","ResponseDate":"2023-01-30T14:31:57.0233333"},{"Id":"E_U1","Name":"Erika Uyterhoeven","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/E_U1","ResponseDate":"2023-02-01T12:24:03.2166667"},{"Id":"MSV1","Name":"Marcus S. Vaughn","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MSV1","ResponseDate":"2023-02-28T16:40:12.6466667"},{"Id":"DTV1","Name":"David T. Vieira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DTV1","ResponseDate":"2023-05-01T13:01:25.6333333"},{"Id":"CJW1","Name":"Christopher J. Worrell","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CJW1","ResponseDate":"2023-01-30T15:44:22.52"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-02-13T12:14:02.5433333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H388/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Scanlon of North Attleborough, a petition (accompanied by bill, House, No. 388) of Adam Scanlon and others for legislation to further regulate the examining and licensing of pipefitters.  Consumer Protection and Professional Licensure.","DocumentText":"\tSection 87 of chapter 146 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting, in line 12, after the word \"employed\" the following words:\r\n\t\"nor shall such provisions apply to such pipefitting performed by a person in the employ of a contractor or subcontractor, retained by one of the above organizations, for any work required on the organization's premises or property.\"\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J17","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J17"},"Votes":[]}],"Amendments":[]}