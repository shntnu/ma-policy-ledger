nches/Senate/Amendments/32/"},{"AmendmentNumber":"33","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/33/"},{"AmendmentNumber":"34","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/34/"},{"AmendmentNumber":"35","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/35/"},{"AmendmentNumber":"36","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/36/"},{"AmendmentNumber":"37","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/37/"},{"AmendmentNumber":"38","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/38/"},{"AmendmentNumber":"39","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/39/"},{"AmendmentNumber":"40","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/40/"},{"AmendmentNumber":"41","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/41/"},{"AmendmentNumber":"42","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/42/"},{"AmendmentNumber":"43","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/43/"},{"AmendmentNumber":"44","ParentBillNumber":"S2898","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2898/Branches/Senate/Amendments/44/"}]}