{"Title":"Extension Order - Advanced Information Technology, the Internet and Cybersecurity","BillNumber":"H4299","DocketNumber":"HD4855","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"TFB1","Name":"Tricia Farley-Bouvier","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2024-02-01T14:27:06.903"},"Cosponsors":[{"Id":"TFB1","Name":"Tricia Farley-Bouvier","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2024-02-01T14:27:06.9033333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4299/DocumentHistoryActions","LegislationTypeName":"Extension Order","Pinslip":null,"DocumentText":"\tOrdered, That notwithstanding the provisions of Joint Rule 10, the committee on Advanced Information Technology, the Internet and Cybersecurity be granted until Monday, April 8, 2024 within which time to make its final report on current Senate documents numbered 25, 34, 195 and 227, and House documents numbered 60, 63, 74, 80 and 83.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Ought to be Adopted","FiscalAmounts":[],"Committee":{"CommitteeCode":"J40","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J40"},"Votes":[]},{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]}],"Amendments":[]}