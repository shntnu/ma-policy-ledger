{"Title":"An Act relative to petit treason","BillNumber":"H1811","DocketNumber":"HD2930","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"T_V1","Name":"Tommy Vitolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_V1","ResponseDate":"2023-01-18T10:18:41.953"},"Cosponsors":[{"Id":"T_V1","Name":"Tommy Vitolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_V1","ResponseDate":"2023-01-18T10:18:41.9533333"},{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-27T15:37:51.92"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H1811/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Vitolo of Brookline, a petition (accompanied by bill, House, No. 1811) of Tommy Vitolo and Sal N. DiDomenico relative to petit treason.  The Judiciary.","DocumentText":"\tSECTION 1. Section 1 of Chapter 265 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking the words \"Petit treason shall be prosecuted and punished as murder.\"\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}