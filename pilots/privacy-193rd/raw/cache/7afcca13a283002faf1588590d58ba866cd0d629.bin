{"Title":"An Act authorizing John R. Stowe, Jr. to purchase creditable service from the Barnstable County Retirement Board","BillNumber":"H3656","DocketNumber":"HD62","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"SGX1","Name":"Steven George Xiarhos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2023-01-06T11:18:43.29"},"Cosponsors":[{"Id":"SGX1","Name":"Steven George Xiarhos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2023-01-06T11:18:43.29"},{"Id":"SLM0","Name":"Susan L. Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLM0","ResponseDate":"2023-01-27T11:19:16.0433333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3656/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Xiarhos of Barnstable, a petition (accompanied by bill, House, No. 3656) of Steven George Xiarhos and Susan L. Moran (with the approval of the county commissioners) that John R. Stowe, Jr., be authorized to purchase creditable service from the Barnstable County Retirement Board.  Public Service.","DocumentText":"\tNotwithstanding section 3 of chapter 71 of the acts of 1996, or any other general or special law to the contrary, the Barnstable county retirement board shall permit John R. Stowe, Jr., a member of the Barnstable county retirement system, to purchase creditable service for his military service time pursuant to paragraph (h) of subdivision (1) of section 4 of chapter 32 of the General Laws.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"S29","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S29"},"Votes":[]}],"Amendments":[]}