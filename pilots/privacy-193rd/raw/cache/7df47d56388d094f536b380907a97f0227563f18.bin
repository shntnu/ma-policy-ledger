{"Title":"An Act relative to adoptions","BillNumber":"H4709","DocketNumber":"HD5103","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2024-05-14T16:45:06.737"},"Cosponsors":[{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2024-05-14T16:45:06.7366667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4709/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Sabadosa of Northampton, a petition (subject to Joint Rule 12) of Lindsay N. Sabadosa relative to adoptions outside of the Commonwealth.  The Judiciary.","DocumentText":"\tSection 2 of chapter 210 of the General Laws, as appearing in the 2022 Official Edition, is hereby amended by striking out the fourth paragraph, in lines 47 to 49, inclusive, and inserting in place thereof the following paragraph:-\r\n\t\"Any surrender given outside of the commonwealth shall be valid for the purpose of this section if it was taken in accordance with the laws of the commonwealth or the laws of the place where it was executed.\"\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}