{"Title":"An Act relative to unpaid student loans","BillNumber":"S1997","DocketNumber":"SD1657","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-18T11:35:53.81"},"Cosponsors":[{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-18T11:35:53.81"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1997/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Fattman, a petition (accompanied by bill, Senate, No. 1997) of Ryan C. Fattman for legislation relative to unpaid student loans.  State Administration and Regulatory Oversight.","DocumentText":"\tSection 13 of chapter 30A of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking out the last paragraph and inserting in place thereof the following paragraph:-\r\n\tNo board of registration operating pursuant to chapter 112 or agency shall deny issuance of, revoke or refuse to renew any professional or occupational certificate, registration, license or authority of an individual based on an individual’s default on an educational loan. This paragraph shall not apply to the division of banks.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J25","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J25"},"Votes":[]}],"Amendments":[]}