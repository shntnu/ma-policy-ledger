{"Title":"An Act to ensure access to library resources and services","BillNumber":"S2839","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J30","Name":"Joint Committee on Tourism, Arts and Cultural Development","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J30","ResponseDate":"2024-06-26T14:32:13.303"},"Cosponsors":[{"Id":"JAC0","Name":"Julian Cyr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAC0","ResponseDate":"2023-06-30T15:05:23.9533333"},{"Id":"JKH1","Name":"James K. Hawkins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JKH1","ResponseDate":"2023-06-14T10:28:12.89"},{"Id":"N_H1","Name":"Natalie M. Higgins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_H1","ResponseDate":"2023-07-10T11:59:15.1333333"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-06-14T12:32:47.0466667"},{"Id":"JFM1","Name":"John Francis Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JFM1","ResponseDate":"2023-07-10T11:59:39.85"},{"Id":"FEP1","Name":"Francisco E. Paulino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/FEP1","ResponseDate":"2023-06-15T08:44:48.67"},{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-07-10T11:59:39.85"},{"Id":"PAH1","Name":"Patricia A. Haddad","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAH1","ResponseDate":"2023-06-16T11:29:51.93"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JMC0","ResponseDate":"2023-07-10T11:59:39.85"},{"Id":"RKK0","Name":"Robyn K. Kennedy","Type":