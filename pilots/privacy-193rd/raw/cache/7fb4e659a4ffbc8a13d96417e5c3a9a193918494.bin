{"Title":"An Act regarding municipal zoning powers","BillNumber":"S1319","DocketNumber":"SD2247","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JRO0","Name":"Jacob R. Oliveira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JRO0","ResponseDate":"2023-01-20T14:36:48.243"},"Cosponsors":[{"Id":"JRO0","Name":"Jacob R. Oliveira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JRO0","ResponseDate":"2023-01-20T14:36:48.2433333"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JMC0","ResponseDate":"2023-02-23T10:22:08.22"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1319/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Oliveira, a petition (accompanied by bill, Senate, No. 1319) of Jacob R. Oliveira and Joanne M. Comerford for legislation relative to municipal zoning powers and the installation of solar energy systems.  Municipalities and Regional Government.","DocumentText":"\tSection 3 of Chapter 40A of the General Laws is hereby amended by striking the following language:\r\n\t\"No zoning ordinance or by-law shall prohibit or unreasonably regulate the installation of solar energy systems or the building of structures that facilitate the collection of solar energy, except where necessary to protect the public health, safety or welfare.\"\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]}],"Amendments":[]}