{"Title":"An Act honoring, empowering, and recognizing our servicemembers and veterans","BillNumber":"H4976","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":null,"Name":"Servicemen and Veterans","Type":2,"Details":null,"ResponseDate":"2024-08-01T03:45:30.71"},"Cosponsors":[{"Id":"GOV7","Name":"Maura T. Healey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/GOV7","ResponseDate":"2023-11-09T14:08:09.87"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4976/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":null,"EmergencyPreamble":"Whereas, The deferred operation of this act would tend to defeat its purpose, which is to forthwith honor, empower and recognize servicemembers and veterans in the commonwealth, therefore it is hereby declared to be an emergency law, necessary for the immediate preservation of the public convenience.\r\n\r\n","RollCalls":[],"Attachments":[{"Description":"Joint Rule 11E Errata","DownloadUrl":"http://malegislature.gov/api/DownloadReport?attachmentId=19008&title=Joint%20Rule%2011E%20Errata"}],"CommitteeRecommendations":[{"Action":"Compromised Version","FiscalAmounts":[],"Committee":{"CommitteeCode":null,"GeneralCourtNumber":193,"Details":null},"Votes":[]}],"Amendments":[]}