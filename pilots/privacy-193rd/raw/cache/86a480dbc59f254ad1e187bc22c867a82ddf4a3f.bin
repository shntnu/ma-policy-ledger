{"Title":"An Act relative to court officers injured on duty","BillNumber":"S1663","DocketNumber":"SD722","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PRF0","Name":"Paul R. Feeney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PRF0","ResponseDate":"2023-01-12T16:46:05.19"},"Cosponsors":[{"Id":"PRF0","Name":"Paul R. Feeney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PRF0","ResponseDate":"2023-01-12T16:46:05.19"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1663/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Feeney, a petition (accompanied by bill, Senate, No. 1663) of Paul R. Feeney for legislation relative to court officers injured on duty.  Public Service.","DocumentText":"\tThe last paragraph of section 58 of chapter 30 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by adding the following sentence:-\r\n\tAll amounts payable under this paragraph shall be paid at the same times and in the same manner as, and for all purposes shall be deemed to be, the regular compensation of such court officer.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}