lCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/23/"},{"AmendmentNumber":"24","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/24/"},{"AmendmentNumber":"25","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/25/"},{"AmendmentNumber":"26","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/26/"},{"AmendmentNumber":"27","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/27/"},{"AmendmentNumber":"28","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/28/"},{"AmendmentNumber":"29","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/29/"},{"AmendmentNumber":"30","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/30/"},{"AmendmentNumber":"31","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/31/"},{"AmendmentNumber":"32","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/32/"},{"AmendmentNumber":"33","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/33/"},{"AmendmentNumber":"34","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/34/"},{"AmendmentNumber":"35","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/35/"},{"AmendmentNumber":"36","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/36/"},{"AmendmentNumber":"37","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/37/"},{"AmendmentNumber":"38","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/38/"},{"AmendmentNumber":"39","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/39/"},{"AmendmentNumber":"40","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/40/"},{"AmendmentNumber":"41","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/41/"},{"AmendmentNumber":"42","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/42/"},{"AmendmentNumber":"43","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/43/"},{"AmendmentNumber":"44","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/44/"},{"AmendmentNumber":"45","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/45/"},{"AmendmentNumber":"46","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/46/"},{"AmendmentNumber":"47","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/47/"},{"AmendmentNumber":"48","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/48/"},{"AmendmentNumber":"49","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/49/"},{"AmendmentNumber":"50","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/50/"},{"AmendmentNumber":"51","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/51/"},{"AmendmentNumber":"52","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/52/"},{"AmendmentNumber":"53","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/53/"},{"AmendmentNumber":"54","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/54/"},{"AmendmentNumber":"55","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/55/"},{"AmendmentNumber":"56","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/56/"},{"AmendmentNumber":"57","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/57/"},{"AmendmentNumber":"58","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/58/"},{"AmendmentNumber":"59","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/59/"},{"AmendmentNumber":"60","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/60/"},{"AmendmentNumber":"61","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/61/"},{"AmendmentNumber":"62","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/62/"},{"AmendmentNumber":"63","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/63/"},{"AmendmentNumber":"64","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/64/"},{"AmendmentNumber":"65","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/65/"},{"AmendmentNumber":"66","ParentBillNumber":"S2806","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2806/Branches/Senate/Amendments/66/"}]}