{"Title":"An Act relative to healthy youth","BillNumber":"H544","DocketNumber":"HD3874","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JJO1","Name":"James J. O'Day","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJO1","ResponseDate":"2023-01-20T14:23:12.997"},"Cosponsors":[{"Id":"JJO1","Name":"James J. O'Day","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJO1","ResponseDate":"2023-01-20T14:23:12.9966667"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-01-20T15:03:02.22"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-01-21T12:53:01.6033333"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-01-21T12:53:01.6033333"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-21T12:53:01.6033333"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-21T12:53:01.6033333"},{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-01-23T10:26:12.1166667"},{"Id":"KIG1","Name":"Kenneth I. Gordon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KIG1","ResponseDate":"2023-01-25T14:53:57.4033333"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-01-25T14:53:57.4033333"},{"Id":"DMD1","Name":"Daniel M. Donahue","Type":1,"Details":"https://malegislature.gov/api/Gen