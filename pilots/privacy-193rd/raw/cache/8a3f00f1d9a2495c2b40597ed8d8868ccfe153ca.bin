{"Title":"An Act establishing a sick leave bank for Stephen Brophy","BillNumber":"H5073","DocketNumber":"HD5156","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PKF1","Name":"Paul K. Frost","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PKF1","ResponseDate":"2024-05-30T11:55:58.193"},"Cosponsors":[{"Id":"PKF1","Name":"Paul K. Frost","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PKF1","ResponseDate":"2024-05-30T11:55:58.1933333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5073/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Frost of Auburn, a petition (subject to Joint Rule 12) of Paul K. Frost for legislation to establish a sick leave bank for Stephen Brophy, an employee of the Department of Correction.  Public Service.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the Department of Correction shall establish a sick leave bank for Stephen Brophy, an employee of the Department. Any employee of the Department may voluntarily contribute 1 or more sick, personal or vacation days to the sick leave bank for use by Stephen Brophy. If Stephen Brophy terminates employment with the Department or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the Department.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}