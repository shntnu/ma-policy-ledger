{"Title":"An Act protecting reproductive health access, LGBTQ lives, religious liberty, and freedom of movement by banning the sale of cell phone location information","BillNumber":"H357","DocketNumber":"HD3698","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"KLG1","Name":"Kate Lipper-Garabedian","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KLG1","ResponseDate":"2023-01-20T14:14:18.77"},"Cosponsors":[{"Id":"KLG1","Name":"Kate Lipper-Garabedian","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KLG1","ResponseDate":"2023-01-20T14:14:18.77"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-01-31T12:36:51.43"},{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-01-31T12:36:51.43"},{"Id":"S_G2","Name":"Steven Ultrino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G2","ResponseDate":"2023-01-31T12:36:51.43"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JMC0","ResponseDate":"2023-01-31T12:36:51.43"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-31T12:36:51.43"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"E_U1","Name":"Erika Uyterhoeven","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/E_U1","ResponseDate":"2023-03-06T11:04:15.38"},{"Id":"S_C1","Name":"Simon Cataldo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_C1","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"jml0","Name":"Jason M. Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/jml0","ResponseDate":"2023-02-03T10:04:00.41"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-02-07T12:56:38.02"},{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-02-07T12:56:38.02"},{"Id":"J_S2","Name":"Jon Santiago","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_S2","ResponseDate":"2023-02-07T12:56:38.02"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-02-07T12:56:38.02"},{"Id":"TMS1","Name":"Thomas M. Stanley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS1","ResponseDate":"2023-02-09T13:30:53.6233333"},{"Id":"PMO","Name":"Patrick M. O'Connor","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-03-02T13:37:08.26"},{"Id":"TFB1","Name":"Tricia Farley-Bouvier","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2023-02-14T10:58:27.4533333"},{"Id":"R_C1","Name":"Rob Consalvo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/R_C1","ResponseDate":"2023-03-02T13:37:08.26"},{"Id":"JBE0","Name":"James B. Eldridge","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBE0","ResponseDate":"2023-03-02T13:37:08.26"},{"Id":"JJO1","Name":"James J. O'Day","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJO1","ResponseDate":"2023-03-02T13:37:08.26"},{"Id":"RME1","Name":"Rodney M. Elliott","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RME1","ResponseDate":"2023-03-22T10:59:41.1466667"},{"Id":"KGH1","Name":"Kevin G. Honan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KGH1","ResponseDate":"2023-03-22T10:59:41.1466667"},{"Id":"N_H1","Name":"Natalie M. Higgins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_H1","ResponseDate":"2023-03-22T10:59:41.1466667"},{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-03-22T10:59:41.1466667"},{"Id":"T_V1","Name":"Tommy Vitolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_V1","ResponseDate":"2023-03-22T10:59:41.1466667"},{"Id":"APR1","Name":"Adrianne Pusateri Ramos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/APR1","ResponseDate":"2023-04-06T15:31:46.2766667"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-06-06T13:47:58.6066667"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-06-06T13:47:58.6066667"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-06-06T13:47:58.6066667"},{"Id":"ACM1","Name":"Adrian C. Madaro","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/ACM1","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"WJD1","Name":"William J. Driscoll, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WJD1","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"JJM2","Name":"John J. Mahoney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJM2","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"JKH1","Name":"James K. Hawkins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JKH1","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"JFM1","Name":"John Francis Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JFM1","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"PAH1","Name":"Patricia A. Haddad","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAH1","ResponseDate":"2023-06-15T12:25:42.95"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-06-27T16:47:10.88"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-06-27T16:47:10.88"},{"Id":"PSS1","Name":"Priscila S. Sousa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PSS1","ResponseDate":"2023-06-27T16:47:10.88"},{"Id":"DWG1","Name":"Danielle W. Gregoire","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DWG1","ResponseDate":"2023-06-27T16:47:10.88"},{"Id":"M_C1","Name":"Mike Connolly","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C1","ResponseDate":"2023-06-27T16:47:10.88"},{"Id":"RBB1","Name":"Ruth B. Balser","