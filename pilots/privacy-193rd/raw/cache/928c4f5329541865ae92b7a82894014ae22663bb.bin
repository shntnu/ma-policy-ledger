{"Title":"An Act to modernize participation in public meetings","BillNumber":"H3040","DocketNumber":"HD3261","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DCG1","Name":"Denise C. Garlick","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DCG1","ResponseDate":"2023-01-19T15:40:03.7"},"Cosponsors":[{"Id":"DCG1","Name":"Denise C. Garlick","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DCG1","ResponseDate":"2023-01-19T15:40:03.7"},{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"AJP1","Name":"Angelo J. Puppolo, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJP1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"TTN1","Name":"Tram T. Nguyen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TTN1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-01-27T10:22:47.47"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-01-30T09:11:00.9633333"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.go