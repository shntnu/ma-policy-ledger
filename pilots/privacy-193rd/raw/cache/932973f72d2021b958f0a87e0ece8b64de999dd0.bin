{"Title":"An Act naming “The Bill Russell and Bob Cousy Highway”","BillNumber":"H3367","DocketNumber":"HD810","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-01-17T13:30:31.473"},"Cosponsors":[{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-01-17T13:30:31.4733333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3367/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Linsky of Natick, a petition (accompanied by bill, House, No. 3367) of David Paul Linsky for legislation to dedicate a portion of the Massachusetts Turnpike as the Bill Russell and Bob Cousy highway.  Transportation.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the portion of the Massachusetts Turnpike between Boston and Worcester shall be named “The Bill Russell and Bob Cousy Highway”. The Department of Transportation shall post appropriate signage to mark this.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]}],"Amendments":[]}