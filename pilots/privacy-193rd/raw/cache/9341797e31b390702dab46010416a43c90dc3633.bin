{"Title":"An Act relative to inmate telephone call rates","BillNumber":"S1550","DocketNumber":"SD2213","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-01-20T14:18:14.137"},"Cosponsors":[{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-01-20T14:18:14.1366667"},{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-04-13T11:09:44.1133333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1550/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Montigny, a petition (accompanied by bill, Senate, No. 1550) of Mark C. Montigny for legislation relative to inmate telephone calls.  Public Safety and Homeland Security.","DocumentText":"\tChapter 127 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting after section 87 the following section:-\r\n\tSection 87A. Subject to appropriation, every inmate of a correctional institution or any other penal institution in the commonwealth shall be provided the ability to make domestic telephone calls at no cost to the inmate or the receiving party.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J22","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J22"},"Votes":[]}],"Amendments":[]}