{"Title":"An Act clarifying call firefighter rights","BillNumber":"S1755","DocketNumber":"SD977","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-01-18T17:22:03.583"},"Cosponsors":[{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-01-18T17:22:03.5833333"},{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-02-28T14:59:46.9633333"},{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-05-22T10:09:59.76"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1755/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Velis, a petition (accompanied by bill, Senate, No. 1755) of John C. Velis and Ryan C. Fattman for legislation to clarify call firefighters rights.  Public Service.","DocumentText":"\tSECTION 1. Section 4(2)(b) of Chapter 32 of the General Laws, as appearing in the 2022 Official Edition, is hereby amended by changing the third to the last word from the end of the second sentence from “the” to “any.”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}