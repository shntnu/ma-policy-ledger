{"Title":"An Act requiring food allergen certification in vocational schools ","BillNumber":"H4418","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J14","Name":"Joint Committee on Education","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14","ResponseDate":"2024-02-05T14:48:51.693"},"Cosponsors":[{"Id":"T_C1","Name":"Tackey Chan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_C1","ResponseDate":"2023-01-11T16:32:34.5166667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4418/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tChapter 74 of the General Laws is hereby amended by inserting after section 14B the following new section:-  \r\n\tSection 14C. Each student of the culinary arts program shall be required to complete and receive the Massachusetts Department of Public Health’s food allergen certification as part of the completion of said program. The state board shall establish rules and regulations consistent with the implementation of this program. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}