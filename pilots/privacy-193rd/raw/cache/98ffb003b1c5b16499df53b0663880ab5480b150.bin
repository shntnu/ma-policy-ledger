{"Title":"An Act validating the actions taken at the Princeton annual town meeting","BillNumber":"H4067","DocketNumber":"HD4541","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"GOV7","Name":"Maura T. Healey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/GOV7","ResponseDate":"2023-08-24T16:23:13.73"},"Cosponsors":[],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4067/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tSECTION 1.  Notwithstanding any general or special law or by-law to the contrary,\r\n\tall acts and proceedings taken by the town of Princeton at the annual town meeting held on June 20, 2023 and all actions taken pursuant thereto are hereby ratified, validated and confirmed to the same extent as if the warrant for the town meeting had been published in full compliance with law.\r\n\tSECTION 2.  This act shall take effect upon its passage.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"S29","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S29"},"Votes":[]}],"Amendments":[]}