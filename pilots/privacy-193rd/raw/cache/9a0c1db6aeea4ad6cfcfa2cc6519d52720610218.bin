{"Title":"An Act relative to adoptions","BillNumber":"S2835","DocketNumber":"SD3233","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CSC0","Name":"Cynthia Stone Creem","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CSC0","ResponseDate":"2024-05-14T16:35:31.82"},"Cosponsors":[{"Id":"CSC0","Name":"Cynthia Stone Creem","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CSC0","ResponseDate":"2024-05-14T16:35:31.82"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2835/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Creem, a petition (accompanied by bill, Senate, No. 2835) (subject to Joint Rule 12) of Cynthia Stone Creem for legislation relative to adoptions outside of the Commonwealth.  The Judiciary.","DocumentText":"\tSection 2 of chapter 210 of the General Laws, as appearing in the 2022 Official Edition, is hereby amended by striking out lines 47 to 49, inclusive, and inserting in place thereof the following paragraph:-\r\n\tAny surrender given outside of the commonwealth shall be valid for the purpose of this section if it was taken in accordance with the laws of the commonwealth or the laws of the place where it was executed.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"J40","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J40"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}