{"Title":"An Act to reduce incidence and death from pancreatic cancer","BillNumber":"H2182","DocketNumber":"HD393","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CLG1","Name":"Carmine Lawrence Gentile","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CLG1","ResponseDate":"2023-01-12T14:52:35.543"},"Cosponsors":[{"Id":"CLG1","Name":"Carmine Lawrence Gentile","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CLG1","ResponseDate":"2023-01-12T14:52:35.5433333"},{"Id":"HEK1","Name":"Hannah Kane","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/HEK1","ResponseDate":"2023-01-12T14:52:43.9666667"},{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-01-30T19:14:07.56"},{"Id":"J_B1","Name":"John Barrett, III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_B1","ResponseDate":"2023-02-23T15:16:43.5466667"},{"Id":"FJB1","Name":"F. Jay Barrows","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/FJB1","ResponseDate":"2023-01-18T12:38:41.2"},{"Id":"DRB1","Name":"Donald R. Berthiaume, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DRB1","ResponseDate":"2023-02-15T14:50:15.2966667"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-01-18T11:36:00.4866667"},{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-02-02T14:42:08.8366667"},{"Id":"PLC1","Name":"Peter Capano","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PLC1","ResponseDate":"2023-01-20T11:47:18.7766667"},{"Id":"M_C2","Name":"Michelle L. Ciccolo","Type"