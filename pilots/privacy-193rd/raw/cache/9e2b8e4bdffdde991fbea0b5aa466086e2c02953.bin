08T09:15:07.7766667"},{"Id":"NJO1","Name":"Norman J. Orrall","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NJO1","ResponseDate":"2024-09-25T14:14:37.13"},{"Id":"FEP1","Name":"Francisco E. Paulino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/FEP1","ResponseDate":"2024-11-01T17:20:04.1733333"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2024-09-24T16:09:46.2766667"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2024-10-10T13:44:42.3366667"},{"Id":"TMS2","Name":"Todd M. Smola","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS2","ResponseDate":"2024-09-25T08:27:43.5666667"},{"Id":"DTV1","Name":"David T. Vieira","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DTV1","ResponseDate":"2024-10-03T07:48:40.9"},{"Id":"BLW1","Name":"Bud L. Williams","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BLW1","ResponseDate":"2024-10-09T14:16:50.4133333"},{"Id":"SGX1","Name":"Steven George Xiarhos","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SGX1","ResponseDate":"2024-09-26T10:56:36.4833333"},{"Id":"JDZ1","Name":"Jonathan D. Zlotnik","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JDZ1","ResponseDate":"2024-09-25T10:48:45.0766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H5117/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Murray of Milford, a petition (subject to Joint Rule 12) of Brian W. Murray and others relative to disqualification from operating commercial motor vehicles.  Transportation.","DocumentText":"\tChapter 90F of the General Laws, as appearing in the 2020 Official Edition, is hereby amended at Section 9 (C) by deleting the word “may” in line 26 and replacing it with the word “shall”.\r\n","EmergencyPreamble":"Whereas, The deferred operation of this act would tend to defeat its purpose, which is to insure a fair and equitable process for determining whether certain persons shall hold a license to operate a commercial motor vehicle, therefore it is hereby declared to be an emergency law, necessary for the immediate preservation of the public safety and convenience.\r\n\r\n","RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]}],"Amendments":[]}