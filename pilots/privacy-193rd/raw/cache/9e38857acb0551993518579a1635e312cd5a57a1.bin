{"Title":"An Act relative to chief probation officers","BillNumber":"S1555","DocketNumber":"SD1505","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MOM0","Name":"Michael O. Moore","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MOM0","ResponseDate":"2023-01-19T15:17:28.143"},"Cosponsors":[{"Id":"MOM0","Name":"Michael O. Moore","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MOM0","ResponseDate":"2023-01-19T15:17:28.1433333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1555/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Moore, a petition (accompanied by bill, Senate, No. 1555) of Michael O. Moore for legislation relative to chief probation officers.  Public Safety and Homeland Security.","DocumentText":"\tSection 3 of Chapter 150E of the General Laws, as appearing in the 2020 Official Edition, is hereby amended in lines 21 through 23, by striking the words:- “, or chief probation officer or acting chief probation officer of any court or region, including, without limitation within the term, any division or department of the trial court”. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J22","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J22"},"Votes":[]}],"Amendments":[]}