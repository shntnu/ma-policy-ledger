Id":"DFD1","Name":"David F. DeCoste","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFD1","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"J_S2","Name":"Jon Santiago","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_S2","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"DMD1","Name":"Daniel M. Donahue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DMD1","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"P_M1","Name":"Paul McMurtry","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/P_M1","ResponseDate":"2023-02-10T10:38:15.4933333"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-02-27T11:16:24.8"},{"Id":"E_U1","Name":"Erika Uyterhoeven","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/E_U1","ResponseDate":"2023-02-27T11:16:24.8"},{"Id":"JBE0","Name":"James B. Eldridge","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBE0","ResponseDate":"2023-02-27T11:16:24.8"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JMC0","ResponseDate":"2023-02-27T11:16:24.8"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-02-27T11:16:24.8"},{"Id":"N_H1","Name":"Natalie M. Higgins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_H1","ResponseDate":"2023-03-28T11:57:23.5933333"},{"Id":"PJK1","Name":"Patrick Joseph Kearney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJK1","ResponseDate":"2023-03-28T11:56:39.7833333"},{"Id":"MSV1","Name":"Marcus S. Vaughn","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MSV1","ResponseDate":"2023-04-13T11:26:25.2666667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H41/DocumentHistoryActions","LegislationTypeName":"Proposal for Constitutional Amendment","Pinslip":"By Representative Schmid of Westport, a petition (accompanied by proposal for constitutional amendment, House, No. 41) of Paul A. Schmid, III and others for a legislative amendment to the Constitution relative to agricultural and horticultural lands.  Revenue.","DocumentText":"\tArticle XCIX of the Amendments to the Constitution is hereby annulled, and the following is adopted in place thereof:-\r\n\tArticle XCIX. Full power and authority are hereby given and granted to the general court to prescribe, for the purpose of developing and conserving agricultural or horticultural lands, that such lands may be valued, for the purpose of taxation, according to their agricultural or horticultural uses; provided, however, that a parcel of land may be valued at less than fair market value under this article if the parcel has been actively devoted to agricultural or horticultural uses for the 2 years preceding the tax year and (1) if the parcel is located in a municipality with a population of less than 50,000 and is 2 acres or more in area; or (2) if the parcel is located in a municipality with a population of 50,000 or more and is ¼ acre or mores in area.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J26","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J26"},"Votes":[]}],"Amendments":[]}