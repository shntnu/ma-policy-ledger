{"Title":"An Act relative to special immigrant juveniles","BillNumber":"H3595","DocketNumber":"HD3070","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JAG2","Name":"Judith A. Garcia","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAG2","ResponseDate":"2023-01-20T08:00:05.707"},"Cosponsors":[{"Id":"JAG2","Name":"Judith A. Garcia","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAG2","ResponseDate":"2023-01-20T08:00:05.7066667"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-03-17T15:18:35.55"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-03-21T14:07:19.2766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3595/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Garcia of Chelsea, a petition (accompanied by bill, House, No. 3595) of Judith A. Garcia, James C. Arena-DeRosa and Samantha Montaño relative to court petitions for special findings in relation to certain immigrant juveniles.  The Judiciary.","DocumentText":"\tSubsection (d) of section 39M of chapter 119 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking out the word “may” and inserting in place thereof the following word:- shall.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}