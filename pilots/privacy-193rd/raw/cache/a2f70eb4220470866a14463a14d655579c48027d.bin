chapter 258 is hereby amended by inserting, after paragraph (4), the following paragraph:- “(5) any claim of sexual abuse of a minor, as defined in section 4C of chapter 260, by a public employee or contractor.” \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}