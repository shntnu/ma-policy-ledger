{"Title":"An Act designating January as Peace Officer History Month","BillNumber":"S1657","DocketNumber":"SD1629","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-13T21:43:21.983"},"Cosponsors":[{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-13T21:43:21.9833333"},{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-02-06T12:24:49.9066667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1657/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Fattman, a petition (accompanied by bill, Senate, No. 1657) of Ryan C. Fattman and David Paul Linsky for legislation to designate January as Peace Officer History Month.  Public Service.","DocumentText":"\tChapter 6 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting after section 15LLLLLL the following section:-\r\n\tSection 15MMMMMM. The governor shall annually issue a proclamation setting apart the month of January as Peace Officer History Month and recommend that the month be observed in an appropriate manner by the people.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Discharge to Another Committee","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J25","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J25"},"Votes":[]}],"Amendments":[]}