{"Title":"An Act relative to petit treason","BillNumber":"S951","DocketNumber":"SD801","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-17T11:37:45.52"},"Cosponsors":[{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-17T11:37:45.52"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S951/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. DiDomenico, a petition (accompanied by bill, Senate, No. 951) of Sal N. DiDomenico for legislation relative to petit treason.  The Judiciary.","DocumentText":"\tSection 1 of Chapter 265 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking the following words:- \"Petit treason shall be prosecuted and punished as murder.\"\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}