{"Title":"An Act relative to Massachusetts solar access law","BillNumber":"S1314","DocketNumber":"SD1772","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"SLM0","Name":"Susan L. Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLM0","ResponseDate":"2023-01-17T19:53:13.743"},"Cosponsors":[{"Id":"SLM0","Name":"Susan L. Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLM0","ResponseDate":"2023-01-17T19:53:13.7433333"},{"Id":"JAC0","Name":"Julian Cyr","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAC0","ResponseDate":"2023-02-15T09:50:11.32"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1314/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Moran, a petition (accompanied by bill, Senate, No. 1314) of Susan L. Moran and Julian Cyr for legislation relative to Massachusetts solar access law.  Municipalities and Regional Government.","DocumentText":"\tSection 3 of Chapter 40A of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting in line 101, after the words \"or welfare.\", the following:- \r\n\tA damage to the above listed \"public health, safety and welfare\" shall be proven in a court of law by local authorities that seek to restrict the use of solar systems attached to permanent buildings. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J10","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J10"},"Votes":[]}],"Amendments":[]}