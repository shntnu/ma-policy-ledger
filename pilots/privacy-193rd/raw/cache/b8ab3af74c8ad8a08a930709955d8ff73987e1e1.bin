{"Title":"An Act relative to executive office of public safety and security dispatchers","BillNumber":"S1667","DocketNumber":"SD1108","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PRF0","Name":"Paul R. Feeney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PRF0","ResponseDate":"2023-01-12T16:37:07.62"},"Cosponsors":[{"Id":"PRF0","Name":"Paul R. Feeney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PRF0","ResponseDate":"2023-01-12T16:37:07.62"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1667/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Feeney, a petition (accompanied by bill, Senate, No. 1667) of Paul R. Feeney for legislation relative to executive office of public safety and security dispatchers.  Public Service.","DocumentText":"\tSection 3 of Chapter 32 of the General Laws, as appearing in the 2014 Official Edition, is hereby amended by inserting after the words \"supervision of prisoners;\", in line 272, the following words:- \r\n\temployees of the Executive Office of Public Safety and Security working as State Police Dispatchers or State 911 Dispatchers in groups SPD 1, 2, and 3 who have been employed in a such a capacity for 10 years or more;\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}