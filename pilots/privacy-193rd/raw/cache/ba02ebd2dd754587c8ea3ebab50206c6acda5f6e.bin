{"CommitteeCode":"S66","FullName":"Senate Committee on Juvenile and Emerging Adult Justice","ShortName":"Juvenile and Emerging Adult Justice (S)","Description":"It shall be the duty of the committee on Juvenile and Emerging Adult Justice to evaluate the existing laws regarding juveniles and emerging adults.  The Committee may hold hearings, as needed, to investigate and gather information. ","Branch":"Senate","GeneralCourtNumber":193,"SenateChairperson":{"GeneralCourtNumber":193,"MemberCode":"BPC0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BPC0"},"HouseChairperson":null,"DocumentsBeforeCommittee":[],"ReportedOutDocuments":[],"Hearings":[{"EventId":4684,"Details":"https://malegislature.gov/api/Hearings/4684"}]}