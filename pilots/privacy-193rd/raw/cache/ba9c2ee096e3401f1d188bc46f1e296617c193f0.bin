{"Title":"An Act establishing a sick leave bank for Tanya Pizzi, an employee of the department of transportation","BillNumber":"H3836","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J23","Name":"Joint Committee on Public Service","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23","ResponseDate":"2023-05-10T12:01:57.403"},"Cosponsors":[{"Id":"JAG1","Name":"Jessica Ann Giannino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAG1","ResponseDate":"2023-04-20T13:04:18.03"},{"Id":"LME0","Name":"Lydia Edwards","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/LME0","ResponseDate":"2023-05-03T17:31:30.2266667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3836/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tNotwithstanding any general or special law to the contrary, the department of transportation shall establish a sick leave bank for Tanya Pizzi, an employee of the department. Any employee of the department may voluntarily contribute 1 or more sick, personal or vacation days to the sick leave bank for use by Tanya Pizzi. If Tanya Pizzi terminates employment with the registry or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the department.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"S31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S31"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H3836","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3836/Branches/House/Amendments/1/"}]}