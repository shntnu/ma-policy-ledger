{"CommitteeCode":"J18","FullName":"Joint Committee on Mental Health, Substance Use and Recovery","ShortName":"Mental Health, Substance Use and Recovery (J)","Description":"It shall be the duty of the committee on Mental Health, Substance Use and Recovery to consider all matters concerning behavioral health, mental illness and substance use disorder, including prevention and early intervention, treatment, recovery services, homelessness, and such other matters as may be referred, It is the Committee’s responsibility to oversee the Department of Mental Health and the Bureau of Substance Addiction Services.\r\n","Branch":"Joint","GeneralCourtNumber":193,"SenateChairperson":{"GeneralCourtNumber":193,"MemberCode":"JCV0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0"},"HouseChairperson":{"GeneralCourtNumber":193,"MemberCode":"ACM1","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/ACM1"},"DocumentsBeforeCommittee":[],"ReportedOutDocuments":[{"BillNumber":"S1234","DocketNumber":"SD2380","Title":"An Act to provide more focused care to individuals suffering from mental health and substance related disabilities","PrimarySponsor":{"Id":"MDB0","Name":"Michael D. Brady","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MDB0","ResponseDate":"2023-01-20T16:23:03.5066667"},"Cosponsors":[{"Id":"MDB0","Name":"Michael D. Brady","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MDB0","ResponseDate":"2023-01-20T16:23:03.5066667"}],"JointSponsor":null,"GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1234","IsDocketBookOnly":false},{"BillNumber":"S1235","DocketNumber":"SD671","Title":"An Act to Protect Patient Rights and Safety and to Promote Accountability by Preventing Misuse and Abuse","PrimarySponsor":{"Id":"WNB0","Name":"William N. Brownsberger","Type":1,"Details":"https://malegislature.gov/api/General