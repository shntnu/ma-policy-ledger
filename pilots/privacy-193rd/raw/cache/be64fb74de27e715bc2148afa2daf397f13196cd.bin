{"Title":"An Act relative to salary range transparency","BillNumber":"H4100","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J43","Name":"Joint Committee on Labor and Workforce Development","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43","ResponseDate":"2023-09-22T16:52:08.243"},"Cosponsors":[{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-01-19T11:52:28.74"},{"Id":"BFO1","Name":"Brandy Fluker Oakley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BFO1","ResponseDate":"2023-01-19T11:56:12.87"},{"Id":"C_T1","Name":"Chynah Tyler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/C_T1","ResponseDate":"2023-01-23T10:45:36.7666667"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-01-23T12:11:18.3533333"},{"Id":"WSP1","Name":"Smitty Pignatelli","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WSP1","ResponseDate":"2023-01-24T09:35:35.4933333"},{"Id":"PDJ0","Name":"Patricia D. Jehlen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PDJ0","ResponseDate":"2023-01-24T11:09:31.2566667"},{"Id":"KIG1","Name":"Kenneth I. Gordon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KIG1","ResponseDate":"2023-01-24T14:17:25.5533333"},{"Id":"FEP1","Name":"Francisco E. Paulino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/FEP1","ResponseDate":"2023-01-24T19:02:49.5633333"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-01-25T00:31:32.4566667"},{"Id":"CJW1","Name":"Christopher J. Worrell","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CJW1","ResponseDate":"2023-01-25T12:09:37.58"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-01-25T16:09:46.26"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-25T17:04:16.96"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-25T22:48:35.2433333"},{"Id":"KPL1","Name":"Kathleen R. LaNatra","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KPL1","ResponseDate":"2023-01-26T13:51:45.8833333"},{"Id":"RBB1","Name":"Ruth B. Balser","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RBB1","ResponseDate":"2023-01-27T11:15:17.63"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-01-27T15:17:03.6833333"},{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-28T18:50:37.5966667"},{"Id":"WJD1","Name":"William J. Driscoll, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WJD1","ResponseDate":"2023-01-30T15:42:18.9466667"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-01-30T16:47:44.1633333"},{"Id":"K_K1","Name":"Kay Khan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_K1","ResponseDate":"2023-02-01T10:45:10.88"},{"Id":"SPK1","Name":"Sally P. Kerans","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SPK1","ResponseDate":"2023-02-01T11:06:23.1366667"},{"Id":"TTN1","Name":"Tram T. Nguyen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TTN1","ResponseDate":"2023-02-01T18:06:10.21"},{"Id":"TMS1","Name":"Thomas M. Stanley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS1","ResponseDate":"2023-02-02T11:23:51.5433333"},{"Id":"MPK1","Name":"Michael P. Kushmerek","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MPK1","ResponseDate":"2023-02-02T11:41:58.4666667"},{"Id":"C_G1","Name":"Carlos González","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/C_G1","ResponseDate":"2023-02-02T15:05:33.92"},{"Id":"S_G2","Name":"Steven Ultrino","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G2","ResponseDate":"2023-02-02T15:32:55.2666667"},{"Id":"CLG1","Name":"Carmine Lawrence Gentile","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CLG1","ResponseDate":"2023-02-02T16:13:09.1333333"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-02-02T16:33:20.0766667"},{"Id":"CMM1","Name":"Christopher M. Markey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMM1","ResponseDate":"2023-02-03T15:39:53.39"},{"Id":"SLG1","Name":"Susannah M. Whipps","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLG1","ResponseDate":"2023-02-03T19:40:27.4133333"},{"Id":"DPL1","Name":"David Paul Linsky","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DPL1","ResponseDate":"2023-02-06T12:10:16.32"},{"Id":"ACM1","Name":"Adrian C. Madaro","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/ACM1","ResponseDate":"2023-02-06T12:53:15