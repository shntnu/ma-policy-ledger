{"Title":"An Act relative to Mass Save reporting","BillNumber":"H3228","DocketNumber":"HD3355","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-20T12:07:42.713"},"Cosponsors":[{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-20T12:07:42.73"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3228/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Sabadosa of Northampton, a petition (accompanied by bill, House, No. 3228) of Lindsay N. Sabadosa relative to Mass Save reporting.  Telecommunications, Utilities and Energy.","DocumentText":"\tSection 22  of Chapter 179 of the Acts of 2022 is hereby amended by inserting in subsection d the following:\r\n\tThis report shall include a list of aggregate energy efficiency services provided through the Mass Save program, organized by municipality and zip code. This report must be available to municipalities within one year.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J37","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J37"},"Votes":[]}],"Amendments":[]}