{"Title":"An Act relative to a youth training wage","BillNumber":"S1168","DocketNumber":"SD2224","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-19T13:15:37.517"},"Cosponsors":[{"Id":"RCF0","Name":"Ryan C. Fattman","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0","ResponseDate":"2023-01-19T13:15:37.5166667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1168/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Fattman, a petition (accompanied by bill, Senate, No. 1168) of Ryan C. Fattman for a legislation relative to a youth training wage.  Labor and Workforce Development.","DocumentText":"\tSection 1 of chapter 151 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by adding at the end of the first paragraph the following:-\r\n\tThis section shall not apply to workers under the age of 18 who work 20 hours or less per week and require a work permit, for the first 120 hours of employment with a new employer. Said 120-hour period shall be referred to as a training period. Said workers under the age of 18 who are in the training period shall be subject to a minimum wage no less than $10 per hour.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J43","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43"},"Votes":[]}],"Amendments":[]}