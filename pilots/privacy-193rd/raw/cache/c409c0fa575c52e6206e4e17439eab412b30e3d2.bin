{"Title":"An Act establishing a sick leave bank for David Benway","BillNumber":"H3738","DocketNumber":"HD4163","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-02-16T12:21:42.837"},"Cosponsors":[{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-02-16T12:21:42.8366667"},{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-02-16T12:21:43.07"}],"JointSponsor":{"Id":"MCM0","Name":"Mark C. Montigny","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCM0","ResponseDate":"2023-02-16T12:21:42.837"},"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3738/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Cabral of New Bedford and Senator Montigny, a joint petition (subject to Joint Rule 12) of Antonio F. D. Cabral and Mark C. Montigny for legislation to establish a sick leave bank for David Benway, an employee of the Massachusetts Maritime Academy.  Public Service.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the Massachusetts Maritime Academy shall establish a sick leave bank for David Benway, an employee of the Academy. Any employee of the Academy may voluntarily contribute 1 or more sick, personal, or vacation days to the sick leave bank for use by David Benway. If David Benway terminates employment with the Academy or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the Academy. \r\n\t \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}