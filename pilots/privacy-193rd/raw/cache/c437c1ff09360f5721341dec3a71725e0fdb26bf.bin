{"CommitteeCode":"J13","FullName":"Joint Committee on Children, Families and Persons with Disabilities","ShortName":"Children, Families and Persons with Disabilities (J)","Description":"It shall be the duty of the Committee on Children, Families and Persons with Disabilities to consider all matters concerning child welfare, juvenile justice, public welfare, and children and adults with physical, developmental or intellectual disabilities.  It is the Committee’s responsibility to oversee the Departments of Children and Families, Developmental Services, Transitional Assistance and Youth Services; the Massachusetts Commissions for the Blind, the Deaf and Hard of Hearing, and the Massachusetts Rehabilitation Commission.","Branch":"Joint","GeneralCourtNumber":193,"SenateChairperson":{"GeneralCourtNumber":193,"MemberCode":"RKK0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RKK0"},"HouseChairperson":{"GeneralCourtNumber":193,"MemberCode":"J_L1","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_L1"},"DocumentsBeforeCommittee":[],"ReportedOutDocuments":[{"BillNumber":"S63","DocketNumber":"SD1434","Title":"An Act to require closed captioning in telecommunications in public areas","PrimarySponsor":{"Id":"MJB0","Name":"Michael J. Barrett","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MJB0","ResponseDate":"2023-01-19T16:09:05.28"},"Cosponsors":[{"Id":"MJB0","Name":"Michael J. Barrett","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MJB0","ResponseDate":"2023-01-19T16:09:05.28"}],"JointSponsor":null,"GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S63","IsDocketBookOnly":false},{"BillNumber":"S64","DocketNumber":"SD293","Title":"An Act to support families","PrimarySponsor":{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMem