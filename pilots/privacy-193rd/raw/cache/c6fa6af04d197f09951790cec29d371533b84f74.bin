islature.gov/api/GeneralCourts/193/LegislativeMembers/PMO"},{"GeneralCourtNumber":193,"MemberCode":"BET0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BET0"}],"Adverse":[],"ReserveRight":[],"NoVoteRecorded":[{"GeneralCourtNumber":193,"MemberCode":"RCF0","Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RCF0"}]}]}]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"S2425","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2425/Branches/Senate/Amendments/1/"},{"AmendmentNumber":"1","ParentBillNumber":"S2207","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2207/Branches/Senate/Amendments/1/"},{"AmendmentNumber":"2","ParentBillNumber":"S2425","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/S2425/Branches/Senate/Amendments/2/"}]}