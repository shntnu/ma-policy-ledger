{"Title":"An Act promoting housing opportunity and mobility through eviction sealing (HOMES)","BillNumber":"H4356","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J19","Name":"Joint Committee on the Judiciary","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19","ResponseDate":"2024-02-05T14:58:10.937"},"Cosponsors":[{"Id":"MJM1","Name":"Michael J. Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MJM1","ResponseDate":"2023-01-17T14:30:58.3733333"},{"Id":"KGH1","Name":"Kevin G. Honan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KGH1","ResponseDate":"2023-01-20T16:26:45.7566667"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-01-22T15:26:50.63"},{"Id":"LME0","Name":"Lydia Edwards","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/LME0","ResponseDate":"2023-01-28T16:03:39.1"},{"Id":"AJP1","Name":"Angelo J. Puppolo, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJP1","ResponseDate":"2023-01-28T16:03:39.1"},{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-02-02T14:53:21.06"},{"Id":"DAL1","Name":"David Henry Argosky LeBoeuf","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DAL1","ResponseDate":"2023-02-02T14:53:21.06"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-02-02T14:53:21.06"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-02-02T14:53:21.06"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"De