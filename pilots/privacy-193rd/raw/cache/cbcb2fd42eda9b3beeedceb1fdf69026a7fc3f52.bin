{"Title":"An Act protecting our soil and farms from PFAS contamination","BillNumber":"H4288","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J38","Name":"Joint Committee on Agriculture","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J38","ResponseDate":"2024-01-08T13:14:40.39"},"Cosponsors":[{"Id":"PAS1","Name":"Paul A. Schmid III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAS1","ResponseDate":"2023-01-17T17:53:40.7733333"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-02-01T12:37:10.7733333"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-02-01T12:37:28.4666667"},{"Id":"MOM0","Name":"Michael O. Moore","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MOM0","ResponseDate":"2023-02-02T12:18:10.4533333"},{"Id":"SLG1","Name":"Susannah M. Whipps","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLG1","ResponseDate":"2023-02-01T12:37:55.25"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-02-01T12:38:23"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-02-01T12:38:41.4533333"},{"Id":"SSH1","Name":"Steven S. Howitt","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SSH1","ResponseDate":"2023-02-01T12:44:34.9166667"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-02-01T12:45:04.8233333"},{"Id":"WSP1","Name":"Smitty Pignatelli","Type":1