{"Title":"An Act relative to inactive voters and municipal census administration","BillNumber":"H702","DocketNumber":"HD2725","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DAL1","Name":"David Henry Argosky LeBoeuf","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DAL1","ResponseDate":"2023-01-19T15:55:55.407"},"Cosponsors":[{"Id":"DAL1","Name":"David Henry Argosky LeBoeuf","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DAL1","ResponseDate":"2023-01-19T15:55:55.4066667"},{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-19T15:55:55.7366667"}],"JointSponsor":{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-19T15:55:55.407"},"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H702/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representatives LeBoeuf of Worcester and Owens of Watertown, a petition (accompanied by bill, House, No. 702) of David Henry Argosky LeBoeuf and Steven Owens relative to inactive voters and municipal census administration.  Election Laws.","DocumentText":"\tSection 37 of chapter 51 of the General Laws, as appearing in the 2016 Official Edition, is hereby amended by striking out the words “of the current year”, in line 29, and inserting in place thereof the following words:- for 2 consecutive years.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J15","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J15"},"Votes":[]}],"Amendments":[]}