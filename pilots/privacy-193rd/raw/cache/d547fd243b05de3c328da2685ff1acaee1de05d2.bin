{"Title":"An Act relative to the use of elephants, big cats, primates, giraffes, and bears in traveling exhibits and shows","BillNumber":"H3245","DocketNumber":"HD3142","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CAF1","Name":"Carole A. Fiola","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAF1","ResponseDate":"2023-01-11T15:41:43.977"},"Cosponsors":[{"Id":"CAF1","Name":"Carole A. Fiola","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAF1","ResponseDate":"2023-01-11T15:41:43.9766667"},{"Id":"BHJ1","Name":"Bradley H. Jones, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BHJ1","ResponseDate":"2023-01-20T10:07:00.3466667"},{"Id":"J_A1","Name":"James Arciero","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_A1","ResponseDate":"2023-03-09T12:07:36.6266667"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-02-16T11:59:27.6333333"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-03-12T09:40:40.6166667"},{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-02-05T16:34:41.3233333"},{"Id":"RBB1","Name":"Ruth B. Balser","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RBB1","ResponseDate":"2023-02-03T17:35:01.86"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-03-21T10:23:54.6833333"},{"Id":"J_B1","Name":"John Barrett, III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_B1","ResponseDate":"2023-01-24T09:35:20.19