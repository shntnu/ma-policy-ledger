{"CommitteeCode":"S48","FullName":"Senate Committee on Post Audit and Oversight","ShortName":"Post Audit and Oversight (S)","Description":"It shall be the duty of the committee on Post Audit and Oversight (established under Section 63 of Chapter 3 of the General Laws) to oversee the development and imple­mentation of legislative auditing programs conducted by the Legislative Post Audit and Oversight Bureau with particular emphasis on performance auditing. ","Branch":"Senate","GeneralCourtNumber":193,"SenateChairperson":null,"HouseChairperson":null,"DocumentsBeforeCommittee":[],"ReportedOutDocuments":[],"Hearings":[{"EventId":4817,"Details":"https://malegislature.gov/api/Hearings/4817"},{"EventId":4921,"Details":"https://malegislature.gov/api/Hearings/4921"}]}