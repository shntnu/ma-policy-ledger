{"Title":"An Act establishing a sick leave bank for Michael Grant","BillNumber":"H3821","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J23","Name":"Joint Committee on Public Service","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23","ResponseDate":"2023-05-02T16:35:50.583"},"Cosponsors":[{"Id":"JJM2","Name":"John J. Mahoney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJM2","ResponseDate":"2023-04-18T16:26:34.6433333"},{"Id":"RKK0","Name":"Robyn K. Kennedy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RKK0","ResponseDate":"2023-04-20T10:43:51.71"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3821/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tNotwithstanding any general or special law to the contrary, the Department of Correction shall establish a sick leave bank for Michael Grant, an employee of the Department. Any employee of the Department may voluntarily contribute 1 or more sick, personal or vacation days to the sick leave bank for use by Michael Grant. If Michael Grant terminates employment with the Department or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the extended illness leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the Department.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"BTR Report","FiscalAmounts":[],"Committee":{"CommitteeCode":"S31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S31"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H3821","Branch":"Senate","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3821/Branches/Senate/Amendments/1/"},{"AmendmentNumber":"1","ParentBillNumber":"H3821","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3821/Branches/House/Amendments/1/"}]}