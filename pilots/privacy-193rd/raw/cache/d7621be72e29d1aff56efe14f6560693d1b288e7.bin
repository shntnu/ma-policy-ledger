{"Title":"An Act relative to HLTV 111 tests","BillNumber":"S1409","DocketNumber":"SD1921","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PWM0","Name":"Paul W. Mark","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PWM0","ResponseDate":"2023-01-19T15:37:55.98"},"Cosponsors":[{"Id":"PWM0","Name":"Paul W. Mark","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PWM0","ResponseDate":"2023-01-19T15:37:55.98"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1409/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. Mark, a petition (accompanied by bill, Senate, No. 1409) of Paul W. Mark for legislation relative to HLTV 111 tests.  Public Health.","DocumentText":"\tSection 70F of chapter 111 of the General Laws is hereby amended by adding the following paragraph:-\r\n\tNotwithstanding the above, if the person’s blood has come in contact with another person who may be infected thereby, such tests shall be performed and the result made known to the person who may have been infected despite the inability or refusal of the person to give written consent.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J16","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J16"},"Votes":[]}],"Amendments":[]}