{"Title":"An Act relative to educator diversity","BillNumber":"H549","DocketNumber":"HD3621","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"AHP1","Name":"Alice Hanlon Peisch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AHP1","ResponseDate":"2023-01-17T15:31:41.927"},"Cosponsors":[{"Id":"AHP1","Name":"Alice Hanlon Peisch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AHP1","ResponseDate":"2023-01-17T15:31:41.9266667"},{"Id":"M_C3","Name":"Manny Cruz","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C3","ResponseDate":"2023-01-23T15:19:19.1"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-01-25T12:45:30.5866667"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-25T12:45:30.5866667"},{"Id":"TTN1","Name":"Tram T. Nguyen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TTN1","ResponseDate":"2023-01-25T12:45:30.5866667"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-01-25T12:45:30.5866667"},{"Id":"S_M1","Name":"Samantha Montaño","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_M1","ResponseDate":"2023-01-27T15:06:22.0933333"},{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-27T15:05:17.67"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-27T15:04:58.67"},{"Id":"FAM1","Name":"Frank A. Moran","Type":1,"Details":"https://malegislature.gov/api/GeneralCourt