{"Title":"An Act allowing electronic delivery receipts for certain bulk sale customers","BillNumber":"H4132","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J17","Name":"Joint Committee on Consumer Protection and Professional Licensure","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J17","ResponseDate":"2023-10-12T14:05:20.147"},"Cosponsors":[{"Id":"JNR1","Name":"Jeffrey N. Roy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JNR1","ResponseDate":"2023-01-18T12:37:22.38"},{"Id":"ERP1","Name":"Edward R. Philips","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/ERP1","ResponseDate":"2023-03-21T09:32:15.17"},{"Id":"TMS1","Name":"Thomas M. Stanley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS1","ResponseDate":"2023-03-21T10:41:36.2333333"},{"Id":"DFD1","Name":"David F. DeCoste","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFD1","ResponseDate":"2023-03-31T10:53:34.5033333"},{"Id":"BHJ1","Name":"Bradley H. Jones, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BHJ1","ResponseDate":"2023-03-31T10:53:34.5033333"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-03-31T10:53:34.5033333"},{"Id":"DWG1","Name":"Danielle W. Gregoire","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DWG1","ResponseDate":"2023-03-31T10:53:34.5033333"},{"Id":"N_C0","Name":"Nick Collins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_C0","ResponseDate":"2023-03-31T10:53:34.5033333"},{"Id":"R_C1","Name":"Rob Consalvo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/R_C1","ResponseDate":"2023-03-31T10:53:34.5033333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4132/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tSECTION 1. Section 303F of chapter 94 of the General Laws, as appearing in the 2022 Official Edition, is hereby amended by striking out the word “time”, in line 16, and inserting in place thereof the following: - “time; provided, however, a vendor using a bulk sale delivery system equipped with the capability of issuing an electronic receipt, ticket or other recorded representation for a bulk sale may give a purchaser the option to receive any information required under this section through electronic means in lieu of or in addition to a paper delivery ticket. If the purchaser opts to receive such information electronically, the vendor shall obtain the purchaser's consent in writing.”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J17","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J17"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"H36","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H36"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"S29","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S29"},"Votes":[]},{"Action":"Correctly Drawn","FiscalAmounts":[],"Committee":{"CommitteeCode":"S31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/S31"},"Votes":[]}],"Amendments":[{"AmendmentNumber":"1","ParentBillNumber":"H4132","Branch":"House","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4132/Branches/House/Amendments/1/"}]}