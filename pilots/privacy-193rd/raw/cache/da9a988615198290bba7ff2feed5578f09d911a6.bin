{"Title":"An Act relative to software legal agreements","BillNumber":"H4102","DocketNumber":"HD4278","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"DWG1","Name":"Danielle W. Gregoire","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DWG1","ResponseDate":"2023-04-12T13:18:44.22"},"Cosponsors":[{"Id":null,"Name":"Andrew Limeri","Type":3,"Details":null,"ResponseDate":"2023-04-19T13:22:56.5833333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4102/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Gregoire of Marlborough (by request), a petition (subject to Joint Rule 12) of Andrew Limeri relative to software legal agreements.  The Judiciary.","DocumentText":"\tSECTION 1.  All updates to a software legal agreement; such as, but not limited to, Terms and Conditions, Terms of Service, and Privacy Policy; must be accompanied by a clear explanation of the changes in the legal agreement and a manner to contact the company to ask questions about the changes.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J19","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19"},"Votes":[]}],"Amendments":[]}