{"Title":"An Act establishing Medicare for all in Massachusetts","BillNumber":"H1239","DocketNumber":"HD1584","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-18T15:55:36.56"},"Cosponsors":[{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-18T15:55:36.56"},{"Id":"DCG1","Name":"Denise C. Garlick","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DCG1","ResponseDate":"2023-01-18T15:56:46.42"},{"Id":"JCD1","Name":"James C. Arena-DeRosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCD1","ResponseDate":"2023-02-18T11:48:54.2"},{"Id":"SBA1","Name":"Shirley B. Arriaga","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SBA1","ResponseDate":"2023-05-08T13:16:41.88"},{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-06-15T09:28:22.0566667"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-09-10T11:01:03.2066667"},{"Id":"RBB1","Name":"Ruth B. Balser","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RBB1","ResponseDate":"2023-02-15T12:41:35.2633333"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-02-23T10:22:43.34"},{"Id":"J_B1","Name":"John Barrett, III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/J_B1","ResponseDate":"2023-02-10T13:23:01.5266667"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-02-08T10:10:02.6333333"},{"Id":"MDB0","Name":"Michael D. Brady","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MDB0","ResponseDate":"2023-05-04T12:00:13.9566667"},{"Id":"AFC1","Name":"Antonio F. D. Cabral","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AFC1","ResponseDate":"2023-12-19T11:41:22.37"},{"Id":"PLC1","Name":"Peter Capano","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PLC1","ResponseDate":"2023-01-30T09:29:07.1366667"},{"Id":"DRC1","Name":"Daniel R. Carey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DRC1","ResponseDate":"2023-02-24T13:56:33.48"},{"Id":"M_C2","Name":"Michelle L. Ciccolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C2","ResponseDate":"2024-01-29T15:50:50.1"},{"Id":"JMC0","Name":"Joanne M. Comerford","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JMC0","ResponseDate":"2023-02-09T10:21:23.9"},{"Id":"M_C1","Name":"Mike Connolly","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C1","ResponseDate":"2023-02-15T14:41:47.7766667"},{"Id":"M_C3","Name":"Manny Cruz","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C3","ResponseDate":"2023-12-08T12:48:33.2566667"},{"Id":"MCD1","Name":"Marjorie C. Decker","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCD1","ResponseDate":"2023-05-03T10:05:32.67"},{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-25T16:24:36.71"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-01-30T15:51:40.3133333"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-01-20T14:34:12.0366667"},{"Id":"K_D1","Name":"Kate Donaghue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_D1","ResponseDate":"2023-02-28T11:24:40.29"},{"Id":"DMD1","Name":"Daniel M. Donahue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DMD1","ResponseDate":"2024-01-30T11:58:59.5366667"},{"Id":"MMD1","Name":"Michelle M. DuBois","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MMD1","ResponseDate":"2023-02-07T21:30:17.69"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-03-01T16:58:31.3166667"},{"Id":"JBE0","Name":"James B. Eldridge","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBE0","ResponseDate":"2023-02-19T14:52:08.2933333"},{"Id":"TFB1","Name":"Tricia Farley-Bouvier","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2023-02-10T09:43:48.2933333"},{"Id":"PRF0","Name":"Paul R. Feeney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PRF0","ResponseDate":"2023-01-26T15:01:03.0033333"},{"Id":"S_G1","Name":"Sean Garballey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_G1","ResponseDate":"2023-08-07T16:28:00.6833333"},{"Id":"JAG2","Name":"Judith A. Garcia","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JAG2","ResponseDate":"2023-11-08T13:22:02.9233333"},{"Id":"CLG1","Name":"Carmine Lawrence Gentile","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CLG1","ResponseDate":"2023-02-02T22:26:54.4166667"},{"Id":"C