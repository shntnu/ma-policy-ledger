slativeMembers/N_C0","ResponseDate":"2023-10-18T16:17:16.6533333"},{"Id":"MSK1","Name":"Mary S. Keefe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MSK1","ResponseDate":"2023-10-18T16:20:38.3066667"},{"Id":"RME1","Name":"Rodney M. Elliott","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RME1","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"C_H1","Name":"Christopher Hendricks","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/C_H1","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"NMB1","Name":"Natalie M. Blais","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/NMB1","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"PAD1","Name":"Patricia A. Duffy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAD1","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"RMH2","Name":"Ryan M. Hamilton","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RMH2","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-10-30T13:36:32.0233333"},{"Id":"T_V1","Name":"Tommy Vitolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_V1","ResponseDate":"2023-10-31T12:43:07.1266667"},{"Id":"PAH1","Name":"Patricia A. Haddad","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAH1","ResponseDate":"2023-10-31T12:43:07.1266667"},{"Id":"CLG1","Name":"Carmine Lawrence Gentile","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CLG1","ResponseDate":"2023-11-01T12:13:46.0033333"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-11-06T15:56:07.8933333"},{"Id":"TMS1","Name":"Thomas M. Stanley","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TMS1","ResponseDate":"2023-11-08T11:35:41.83"},{"Id":"CMM1","Name":"Christopher M. Markey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMM1","ResponseDate":"2023-11-08T16:10:04.8633333"},{"Id":"M_C1","Name":"Mike Connolly","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C1","ResponseDate":"2023-11-08T16:10:04.8633333"},{"Id":"K_K1","Name":"Kay Khan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_K1","ResponseDate":"2023-11-21T12:14:27.5033333"},{"Id":"SLG1","Name":"Susannah M. Whipps","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLG1","ResponseDate":"2023-12-01T12:24:56.33"},{"Id":"JDZ1","Name":"Jonathan D. Zlotnik","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JDZ1","ResponseDate":"2023-12-01T12:24:56.33"},{"Id":"S_C1","Name":"Simon Cataldo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_C1","ResponseDate":"2023-12-01T12:24:56.33"},{"Id":"TTN1","Name":"Tram T. Nguyen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TTN1","ResponseDate":"2023-12-11T11:46:29.1566667"},{"Id":"SPK1","Name":"Sally P. Kerans","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SPK1","ResponseDate":"2023-12-11T11:46:29.1566667"},{"Id":"EAR1","Name":"Estela A. Reyes","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/EAR1","ResponseDate":"2023-12-19T11:09:40.0666667"},{"Id":"E_U1","Name":"Erika Uyterhoeven","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/E_U1","ResponseDate":"2024-01-12T12:23:33.8333333"},{"Id":"MCD1","Name":"Marjorie C. Decker","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCD1","ResponseDate":"2024-02-16T11:35:37.2466667"},{"Id":"PJK1","Name":"Patrick Joseph Kearney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJK1","ResponseDate":"2024-04-10T12:45:58.5333333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H2006/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative O'Day of West Boylston, a petition (accompanied by bill, House, No. 2006) of James J. O'Day and Daniel M. Donahue relative to applied behavioral health clinic rates.  Mental Health, Substance Use and Recovery.","DocumentText":"\tSECTION 1. Chapter 118E of the general laws, as appearing in the 2020 official edition, is hereby amended by inserting after 13D the following section:-\r\n\tSection 13D ½.\r\n\t(a) For the purposes of this section, the following words shall have the following meanings:\r\n\t“Behavioral health clinic”, a clinic licensed by the department of public health pursuant to section 3 and sections 51 through 56 of chapter 111 of the general laws, as appearing in the 2020 official edition, and regulated pursuant to title 130 of the code of Massachusetts regulations 429.000.\r\n\t“Behavioral health services”, evaluation, diagnosis, treatment, care coordination, management, or peer support of patients with mental health, developmental or substance use disorder.\r\n\t“Independent practitioner”, an individual who is licensed by the board to practice independent clinical social work and who meets the qualifications set forth in section 131 of chapter 112 of the general laws, as appearing in the 2020 official edition, for an independent clinical social worker and is regulated pursuant to title 130 of the code of Massachusetts regulations 462.000.\r\n\t“Minimum payment rates”, rates of payment for services below which managed care entities may not enter into provider agreements.\r\n\t(b) The division shall increase minimum payment rates for behavioral health services by 5% per procedure code for rates of payment effective as of January 1, 2023.\r\n\t(c) Pursuant to sections 13C and 13D, and notwithstanding applicable state and federal laws, the division shall ensure that each rate of payment or component payment in a bundled rate for behavioral health services delivered in behavioral health clinics are no less than 20% above comparable behavioral health services delivered by independent practitioners.\r\n\t(d) The division shall review behavioral health service rates biennially. This review shall include, but not be limited to the following: (i) adoption of an inflationary adjustment factor no less than the total Medicare Economic Index percentage for the past two calendar years; (ii) where possible, comparison of the wage estimate for each classification of staff position to the 75th percentile wage estate for that position as determined by the most current United States Bureau of Labor Statistics for the commonwealth; and (iii) consideration of the reasonable cost to providers of any existing or new governmental mandate that has been enacted, promulgated or imposed by any governmental unit or federal governmental authority.\r\n\tSECTION 2. Said chapter 118E is hereby amended by inserting after section 13K the following new section:-\r\n\tSection 13L.\r\n\t(a) For the purposes of this section, the following words shall have the following meanings:\r\n\t“Behavioral health clinic”, a clinic licensed by the department of public health pursuant to section 3 and sections 51 through 56 of chapter 111 of the general laws, as appearing in the 2020 official edition, and that is regulated pursuant to title 130 of the code of Massachusetts regulations 429.000.\r\n\t“Behavioral health services”, evaluation, diagnosis, treatment, care coordination, management or peer support of patients with mental health, developmental or substance use disorder.\r\n\t“Independent practitioner”, an individual who is licensed by the board to practice independent clinical social work and who meets the qualifications set forth in section 131 of chapter 112 of the general laws, as appearing in the 2020 official edition, and who is regulated pursuant to title 130 of the code of Massachusetts regulations 462.000.\r\n\t“Managed care entity”, all contracted health insurers, health plans, health maintenance organizations, behavioral health management firms and third party administrators under contract to a Medicaid managed care organization or primary care clinician plan, and accountable care organizations.\r\n\t“Minimum payment rates”, rates of payment for services below which managed care entities may not enter into provider agreements.\r\n\t(b) Notwithstanding applicable state and federal laws, the division shall direct its managed care entities to increase minimum payment rates for behavioral health services by 5% per procedure code for rates of payment effective as of January 1, 2023.\r\n\t(c) The division shall direct managed care entities to ensure that each rate of payment or component payment in a bundled rate for behavioral health services delivered in behavioral health clinics is no less than 20% above comparable behavioral health services delivered by independent practitioners.\r\n\t(d) The division shall review rates of payment by managed care entities for behavioral health services biennially. This review shall include, but not be limited to the following: (i) adoption of an inflationary adjustment factor no less than the total Medicare Economic Index percentage for the past two calendar years; (ii) where possible, comparison of the wage estimate for each classification of staff position to the 75th percentile wage estate for that position as determined by the most current United States Bureau of Labor Statistics for the commonwealth; and (iii) consideration of the reasonable cost to providers of any existing or new governmental mandate that has been enacted, promulgated or imposed by any governmental unit or federal governmental authority.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J18","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J18"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J24","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J24"},"Votes":[]}],"Amendments":[]}