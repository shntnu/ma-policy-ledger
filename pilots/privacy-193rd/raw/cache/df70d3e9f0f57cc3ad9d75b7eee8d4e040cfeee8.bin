/malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TFB1","ResponseDate":"2023-02-14T07:34:15.6333333"},{"Id":"PJK1","Name":"Patrick Joseph Kearney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJK1","ResponseDate":"2023-02-14T07:34:15.6333333"},{"Id":"N_H1","Name":"Natalie M. Higgins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/N_H1","ResponseDate":"2023-02-16T11:52:52.3666667"},{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-02-16T11:52:52.3666667"},{"Id":"JBE0","Name":"James B. Eldridge","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBE0","ResponseDate":"2023-02-22T09:39:17.9"},{"Id":"M_C2","Name":"Michelle L. Ciccolo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C2","ResponseDate":"2023-03-06T09:23:59.8733333"},{"Id":"BHJ1","Name":"Bradley H. Jones, Jr.","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BHJ1","ResponseDate":"2023-03-31T13:18:55.0533333"},{"Id":"JBL0","Name":"Joan B. Lovely","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBL0","ResponseDate":"2023-06-30T15:25:01.97"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4310/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tChapter 23A is hereby amended by adding the following new section:- \r\n\tSection 69. Grants allocated to regional tourism councils through the Massachusetts Tourism Trust Fund established in section 13T in chapter 23A shall be distributed as follows; at least 50% of the total grant funds available shall be distributed not later than September 1st of the fiscal year in which they are allocated, and the remainder of the grants shall be allocated not later than December 1st of the fiscal year in which they are allocated.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J30","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J30"},"Votes":[]}],"Amendments":[]}