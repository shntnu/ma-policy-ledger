{"Title":"An Act to prevent abuse and exploitation","BillNumber":"H4115","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J19","Name":"Joint Committee on the Judiciary","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J19","ResponseDate":"2023-10-05T16:17:36.54"},"Cosponsors":[{"Id":"JNR1","Name":"Jeffrey N. Roy","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JNR1","ResponseDate":"2023-01-04T11:23:34.68"},{"Id":"JCV0","Name":"John C. Velis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JCV0","ResponseDate":"2023-01-19T13:34:22.7066667"},{"Id":"JFK0","Name":"John F. Keenan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JFK0","ResponseDate":"2023-01-11T16:45:50.2666667"},{"Id":"TTN1","Name":"Tram T. Nguyen","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/TTN1","ResponseDate":"2023-01-18T19:18:34.21"},{"Id":"RMH1","Name":"Richard M. Haggerty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RMH1","ResponseDate":"2023-01-20T10:11:20.7633333"},{"Id":"M_K1","Name":"Meghan K. Kilcoyne","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_K1","ResponseDate":"2023-01-20T09:22:33.8666667"},{"Id":"AJS1","Name":"Adam J. Scanlon","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AJS1","ResponseDate":"2023-01-09T12:10:11.6466667"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-02-06T15:16:18.8966667"},{"Id":"KPL1","Name":"Kathleen R. LaNatra","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/KPL1","ResponseDate":"2023-01-24T13:20:37.6766667"},{"Id":"CPB2","Name":"Christine P. Barber","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CPB2","ResponseDate":"2023-02-06T15:16:18.8966667"},{"Id":"CMM1","Name":"Christopher M. Markey","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMM1","ResponseDate":"2023-02-06T15:16:18.8966667"},{"Id":"M_D2","Name":"Mindy Domb","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_D2","ResponseDate":"2023-01-24T17:25:09.5366667"},{"Id":"JKH1","Name":"James K. Hawkins","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JKH1","ResponseDate":"2023-02-14T11:33:04.48"},{"Id":"MMD1","Name":"Michelle M. DuBois","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MMD1","ResponseDate":"2023-02-13T17:03:41.2766667"},{"Id":"SLG1","Name":"Susannah M. Whipps","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLG1","ResponseDate":"2023-01-24T19:24:16.2733333"},{"Id":"WFT0","Name":"Walter F. Timilty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/WFT0","ResponseDate":"2023-02-14T11:33:04.48"},{"Id":"JPL1","Name":"Jack Patrick Lewis","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JPL1","ResponseDate":"2023-01-26T10:34:52.15"},{"Id":"T_C1","Name":"Tackey Chan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/T_C1","ResponseDate":"2023-02-14T11:33:04.48"},{"Id":"AMG0","Name":"Anne M. Gobi","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/AMG0","ResponseDate":"2023-02-21T13:39:57.4333333"},{"Id":"K_K1","Name":"Kay Khan","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_K1","ResponseDate":"2023-02-14T11:33:04.48"},{"Id":"MOM0","Name":"Michael O. Moore","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MOM0","ResponseDate":"2023-0