slature.gov/api/GeneralCourts/193/LegislativeMembers/REH1","ResponseDate":"2023-06-14T10:46:37.5266667"},{"Id":"C_T1","Name":"Chynah Tyler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/C_T1","ResponseDate":"2023-07-17T11:52:33.13"},{"Id":"S_C1","Name":"Simon Cataldo","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/S_C1","ResponseDate":"2023-08-25T17:39:12.0433333"},{"Id":"V_H1","Name":"Vanna Howard","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/V_H1","ResponseDate":"2023-08-25T17:39:12.0433333"},{"Id":"M_C1","Name":"Mike Connolly","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/M_C1","ResponseDate":"2023-09-06T14:14:10.0966667"},{"Id":"EAR1","Name":"Estela A. Reyes","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/EAR1","ResponseDate":"2023-11-14T14:04:52.8933333"},{"Id":"MCD1","Name":"Marjorie C. Decker","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MCD1","ResponseDate":"2023-12-11T11:46:53.5033333"},{"Id":"K_D1","Name":"Kate Donaghue","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/K_D1","ResponseDate":"2023-12-11T11:46:53.5033333"},{"Id":"JBA1","Name":"Jennifer Balinsky Armini","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JBA1","ResponseDate":"2023-12-19T11:09:56.21"},{"Id":"PLC1","Name":"Peter Capano","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PLC1","ResponseDate":"2024-01-09T12:51:22.48"},{"Id":"DFC1","Name":"Daniel Cahill","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFC1","ResponseDate":"2024-01-09T12:51:22.48"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3388/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative O'Day of West Boylston, a petition (accompanied by bill, House, No. 3388) of James J. O'Day and others that the Registrar of Motor Vehicles provide identification to youth and adults experiencing homelessness.  Transportation.","DocumentText":"\tSection 8E of chapter 90 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by adding the following 2 paragraphs:-\r\n\tThe regulations establishing criteria for identification cards shall include a process for a person who is homeless or is an unaccompanied homeless youth to apply for a Massachusetts identification card and to waive any fees associated with obtaining the identification card; provided, however, that the process shall allow for a person who is homeless or is an unaccompanied homeless youth to submit proof of residency by providing documentation that is satisfactory to the registrar and that is: (i) from an entity that provides housing services or youth services in the commonwealth, including, but not limited to, homeless service providers; or (ii) evidence of services that the person received from a department, division, office or agency of the executive office of health and human services. The registrar and the state secretary shall enter into a memorandum of understanding under section 42G ½ of chapter 51 to implement this paragraph, as appropriate.\r\n\tFor the purposes of this section, the following terms shall have the following meanings:\r\n\t“Homeless”, shall have the same meaning as in section 103 of the federal Stewart B. McKinney Homeless Assistance Act of 1987, 42 USC 11302, as amended.\r\n\t“Unaccompanied homeless youth”, a person who: (i) is 24 years of age or younger; (ii) is not in the physical custody or care of a parent or legal guardian; and (iii) lacks a fixed, regular and adequate nighttime residence.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]}],"Amendments":[]}