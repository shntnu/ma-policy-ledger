{"Title":"An Act relative to veterans benefits","BillNumber":"H3501","DocketNumber":"HD1341","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"CMG1","Name":"Colleen M. Garry","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMG1","ResponseDate":"2023-01-10T15:08:21.193"},"Cosponsors":[{"Id":"CMG1","Name":"Colleen M. Garry","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CMG1","ResponseDate":"2023-01-10T15:08:21.1933333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3501/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Garry of Dracut, a petition (accompanied by bill, House, No. 3501) of Colleen M. Garry relative to the calculation of benefits of veterans receiving public housing and other public assistance.  Veterans and Federal Affairs.","DocumentText":"\tSection 5 of Chapter 115 shall be amended by adding at the end the following:\r\n\tAny increase in existing benefits provided to the veteran under this section shall not be included in any calculation for public housing or any other public assistance program. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J31"},"Votes":[]}],"Amendments":[]}