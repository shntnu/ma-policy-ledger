{"Title":"An Act establishing Massachusetts Learning Disability Screening Day","BillNumber":"H4210","DocketNumber":"HD4609","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-10-02T12:37:07.3"},"Cosponsors":[{"Id":"JSC1","Name":"Josh S. Cutler","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JSC1","ResponseDate":"2023-10-02T12:37:07.3"},{"Id":null,"Name":"Matthew NeJame","Type":3,"Details":null,"ResponseDate":"2023-10-05T12:45:50.14"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4210/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Cutler of Pembroke, a petition (subject to Joint Rule 12) of Josh S. Cutler and Matthew NeJame for the issuance of an annual proclamation by the Governor to designate October 2 as learning disability screening day.  State Administration and Regulatory Oversight.","DocumentText":"\tChapter 6 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by inserting after section 15ZZZZZZ, the following section:-\r\n\tSection 15AAAAAAA. The governor shall annually issue a proclamation setting apart October 2 as Learning Disability Screening Day, to raise awareness of the necessity of screening for reading disabilities and recommending that the day be observed in an appropriate manner by the people.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J25","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J25"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]}],"Amendments":[]}