{"Title":"An Act providing for payment by the Commonwealth of wages for members of the United States Coast Guard during the shut-down, so-called, of the United States Government","BillNumber":"H4441","DocketNumber":null,"GeneralCourtNumber":193,"PrimarySponsor":{"Id":"J43","Name":"Joint Committee on Labor and Workforce Development","Type":2,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43","ResponseDate":"2024-02-05T16:32:54.297"},"Cosponsors":[{"Id":"PJK1","Name":"Patrick Joseph Kearney","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PJK1","ResponseDate":"2023-01-17T18:19:45.4766667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4441/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":null,"DocumentText":"\tNotwithstanding any general or special law to the contrary, the salaries of members of the United States Coast Guard who are residents of the commonwealth shall be paid by the commonwealth, subject to appropriation, during the pendency of any so-called federal government shut-down. The funds for such payments shall be paid from an account to be determined by the Governor. Upon the conclusion of the so-called federal government shut-down, the Commonwealth shall seek reimbursement from the federal government for the costs of any such payments made. \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Redraft","FiscalAmounts":[],"Committee":{"CommitteeCode":"J43","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J43"},"Votes":[]}],"Amendments":[]}