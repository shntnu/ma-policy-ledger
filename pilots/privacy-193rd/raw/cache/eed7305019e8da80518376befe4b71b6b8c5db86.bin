{"Title":"An Act relative to disability benefits for veterans ","BillNumber":"H3536","DocketNumber":"HD996","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PAS1","Name":"Paul A. Schmid III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAS1","ResponseDate":"2023-01-17T17:50:54.65"},"Cosponsors":[{"Id":"PAS1","Name":"Paul A. Schmid III","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAS1","ResponseDate":"2023-01-17T17:50:54.65"},{"Id":"C_H1","Name":"Christopher Hendricks","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/C_H1","ResponseDate":"2023-02-01T14:22:56.8166667"},{"Id":"BWM1","Name":"Brian W. Murray","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BWM1","ResponseDate":"2023-02-01T14:22:56.8166667"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-02-01T14:22:56.8166667"},{"Id":"DFD1","Name":"David F. DeCoste","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/DFD1","ResponseDate":"2023-02-10T10:38:38.4566667"},{"Id":"A_S1","Name":"Alan Silvia","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/A_S1","ResponseDate":"2023-02-10T10:38:38.4566667"},{"Id":"SLG1","Name":"Susannah M. Whipps","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SLG1","ResponseDate":"2023-02-10T10:38:38.4566667"},{"Id":"PAH1","Name":"Patricia A. Haddad","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PAH1","ResponseDate":"2023-02-10T10:38:38.4566667"},{"Id":"CAD1","Name":"Carol A. Doherty","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/CAD1","ResponseDate":"2023-02-10T10:38:38.4566667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3536/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Schmid of Westport, a petition (accompanied by bill, House, No. 3536) of Paul A. Schmid, III and others relative to disability benefits for veterans.  Veterans and Federal Affairs.","DocumentText":"\tSection 5 of chapter 115 of the General Laws, as appearing in the 2020  Official Edition, is hereby amended by inserting, after the word “made”, in line 36, the following words: “; and provided further that, the effective date of an award of disability compensation to a veteran shall be the day following the date of the veteran's discharge or release if application therefor is received within 1 year from such date of discharge or release.”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J31","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J31"},"Votes":[]}],"Amendments":[]}