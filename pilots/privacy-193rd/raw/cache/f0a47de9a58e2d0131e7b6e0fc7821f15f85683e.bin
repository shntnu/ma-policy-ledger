{"Title":"An Act to prevent concussion and head injury","BillNumber":"H429","DocketNumber":"HD450","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-01-13T10:08:14.893"},"Cosponsors":[{"Id":"BMA1","Name":"Brian M. Ashe","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/BMA1","ResponseDate":"2023-01-13T10:08:14.8933333"},{"Id":"L_S1","Name":"Lindsay N. Sabadosa","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/L_S1","ResponseDate":"2023-01-20T16:04:17.3866667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H429/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Ashe of Longmeadow, a petition (accompanied by bill, House, No. 429) of Brian M. Ashe and Lindsay N. Sabadosa relative to head gear for students who participate in soccer contests.  Education.","DocumentText":"\tAny student who participates in soccer contests, competitions or practices shall be permitted to wear protective headgear on the field, provided that such headgear satisfies relevant federal standards for headgear used in soccer.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J14","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J14"},"Votes":[]}],"Amendments":[]}