{"Title":"An Act relative to the safety of children in school buses","BillNumber":"S1573","DocketNumber":"SD158","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"PMO","Name":"Patrick M. O'Connor","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-01-11T15:05:55.5"},"Cosponsors":[{"Id":"PMO","Name":"Patrick M. O'Connor","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/PMO","ResponseDate":"2023-01-11T15:05:55.5"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1573/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. O'Connor, a petition (accompanied by bill, Senate, No. 1573) of Patrick M. O'Connor for legislation relative to the safety of children in school buses.  Public Safety and Homeland Security.","DocumentText":"\tSection 7B of Chapter 90 of the General Laws is hereby amended by striking the sentence beginning after “(8)” in line 84 and inserting thereof the following:-\r\n\t\"Every school bus shall be equipped with safety belts for the operator thereof and for every seat that is designated to a pupil, and said operator and pupils shall securely fasten said seat belts while the school bus is in motion”\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J22","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J22"},"Votes":[]}],"Amendments":[]}