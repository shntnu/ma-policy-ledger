{"Title":"An Act modernizing birth certificates","BillNumber":"S1459","DocketNumber":"SD1801","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-01-19T23:02:53.117"},"Cosponsors":[{"Id":"RLR0","Name":"Rebecca L. Rausch","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/RLR0","ResponseDate":"2023-01-19T23:02:53.1166667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S1459/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Ms. Rausch, a petition (accompanied by bill, Senate, No. 1459) of Rebecca L. Rausch for legislation to modernize birth certificates.  Public Health.","DocumentText":"\tSection 1 of chapter 46 of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by striking out the first sentence of the second paragraph and inserting in place thereof the following sentence:- In the record of births, date of birth, place of birth, name and sex of the child; names, places of birth, and dates of birth of the parent or parents; and residence and birth surname of the person who gave birth to the child.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J16","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J16"},"Votes":[]}],"Amendments":[]}