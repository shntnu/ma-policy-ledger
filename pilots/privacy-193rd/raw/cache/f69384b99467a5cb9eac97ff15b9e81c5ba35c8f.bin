{"Title":"An Act to improve notice requirements of hazardous waste release","BillNumber":"S470","DocketNumber":"SD800","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-17T11:44:12.047"},"Cosponsors":[{"Id":"SND0","Name":"Sal N. DiDomenico","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SND0","ResponseDate":"2023-01-17T11:44:12.0466667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/S470/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Mr. DiDomenico, a petition (accompanied by bill, Senate, No. 470) of Sal N. DiDomenico for legislation to improve notice requirements of hazardous waste release.  Environment and Natural Resources.","DocumentText":"\tSection 4 of chapter 21E of the General Laws, as appearing in the 2020 Official Edition, is hereby amended by adding after “such action” the following words:- \"The department shall file a copy of the notice with the registry of deeds or the registry district of the land court of the county in which the real property is located not later than 30 days after the notice is mailed to the responsible party. Upon completion of necessary and appropriate response action regarding the release, the department shall file a timely notice of compliance with the registry of deeds or the registry district of the land court of the county in which the real property is located\".  \r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J21","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J21"},"Votes":[]}],"Amendments":[]}