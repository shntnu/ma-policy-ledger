{"Title":"An Act establishing a sick leave bank for Matthew McRae","BillNumber":"H4084","DocketNumber":"HD4556","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-08-31T13:59:26.183"},"Cosponsors":[{"Id":"MRS1","Name":"Margaret R. Scarsdale","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/MRS1","ResponseDate":"2023-08-31T13:59:26.1833333"},{"Id":"JJC0","Name":"John J. Cronin","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/JJC0","ResponseDate":"2023-09-05T09:08:11.9666667"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H4084/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Scarsdale of Pepperell, a petition (subject to Joint Rule 12) of Margaret R. Scarsdale and John J. Cronin for legislation to establish a sick leave bank for Matthew McRae, an employee of the Department of the State Police.  Public Service.","DocumentText":"\tNotwithstanding any general or special law to the contrary, the Massachusetts State Police shall establish a sick leave bank for Matthew McRae, an employee of the State Police. Any employee of the State Police may voluntarily contribute 1 or more sick, personal or vacation days to the sick leave bank for use by Matthew McRae. If Matthew McRae terminates employment with the State Police or requests to dissolve the sick leave bank, any remaining time in the sick leave bank shall be transferred to the State Police paid leave bank. Sick leave bank days shall not be used for absences unrelated to the illness or disability that necessitated the establishment of the sick leave bank as determined by the State Police.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Suspend Rules","FiscalAmounts":[],"Committee":{"CommitteeCode":"H33","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H33"},"Votes":[]},{"Action":"Accompanied","FiscalAmounts":[],"Committee":{"CommitteeCode":"J23","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J23"},"Votes":[]}],"Amendments":[]}