{"Title":"An Act to promote transportation demand management ","BillNumber":"H3396","DocketNumber":"HD585","GeneralCourtNumber":193,"PrimarySponsor":{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-10T15:17:39.133"},"Cosponsors":[{"Id":"SCO1","Name":"Steven Owens","Type":1,"Details":"https://malegislature.gov/api/GeneralCourts/193/LegislativeMembers/SCO1","ResponseDate":"2023-01-10T15:17:39.1333333"}],"JointSponsor":null,"BillHistory":"https://malegislature.gov/api/GeneralCourts/193/Documents/H3396/DocumentHistoryActions","LegislationTypeName":"Bill","Pinslip":"By Representative Owens of Watertown, a petition (accompanied by bill, House, No. 3396) of Steven Owens relative to local community master plan transportation demand management.  Transportation.","DocumentText":"\tSECTION 1. Section 81D of Chapter 41 of the General Laws is hereby amended by inserting after the word “plan” in line 52 the following: -\r\n\t(10) A Transportation Demand Management (TDM) element, which studies how TDM programs and collaboration with a local Transportation Management Association (TMA) (either existing or new) can reduce congestion and improve mobility within the community.\r\n","EmergencyPreamble":null,"RollCalls":[],"Attachments":[],"CommitteeRecommendations":[{"Action":"Favorable","FiscalAmounts":[],"Committee":{"CommitteeCode":"J27","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/J27"},"Votes":[]},{"Action":"Place in OD","FiscalAmounts":[],"Committee":{"CommitteeCode":"H52","GeneralCourtNumber":193,"Details":"https://malegislature.gov/api/GeneralCourts/193/Committees/H52"},"Votes":[]}],"Amendments":[]}